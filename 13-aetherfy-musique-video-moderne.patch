@@ -0,0 +1,182 @@
+/* ==========================================================================
+   AetherFy (Vidéo + Musique) — même langage visuel que l'accueil : verre
+   sombre, lueurs, survols qui soulèvent, titres accentués. Propriétés de
+   PEINTURE uniquement (fond, bordure, rayon, ombre, transitions) : aucune
+   mise en page n'est modifiée. Les états de départ des animations sont
+   l'état final visible (si `prefers-reduced-motion` les coupe, rien ne
+   reste caché).
+   ========================================================================== */
+
+/* ---------- Coque AetherFy Vidéo ---------- */
+
+.afy-sidebar {
+  background:
+    linear-gradient(180deg, rgba(124, 92, 255, 0.12) 0%, transparent 45%),
+    color-mix(in srgb, var(--afy-surface-1) 82%, transparent);
+  -webkit-backdrop-filter: blur(16px);
+  backdrop-filter: blur(16px);
+  border-right: 1px solid rgba(255, 255, 255, 0.08);
+}
+.afy-topbar {
+  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
+}
+
+/* ---------- En-têtes de pages (Tendances, Abonnements, Bibliothèque…) ---------- */
+
+.afy-page-head {
+  position: relative;
+  isolation: isolate;
+  padding-top: 18px;
+  margin-bottom: 6px;
+  animation: afy-m-rise 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+.afy-page-head::before {
+  content: "";
+  position: absolute;
+  inset: -1.5rem 0 -0.5rem;
+  z-index: -1;
+  pointer-events: none;
+  background: radial-gradient(40% 90% at 6% 40%, rgba(255, 46, 99, 0.18), transparent 72%);
+}
+#root .afy-page-head h1 {
+  font-family: var(--font-display);
+  font-size: clamp(1.4rem, 2.4vw, 1.9rem);
+  background: linear-gradient(90deg, var(--afy-text), #ffb4c6 85%);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+/* L'icône d'en-tête devient un emblème (même idée que ModernPageHeader) */
+.afy-page-head h1 > svg:first-child {
+  box-sizing: content-box;
+  width: 22px;
+  height: 22px;
+  padding: 11px;
+  border-radius: 14px;
+  color: #fff !important;
+  background: linear-gradient(135deg, #ff2e63, #ff9f1c);
+  box-shadow: 0 8px 24px rgba(255, 46, 99, 0.35);
+}
+
+/* ---------- Titres de rangées ---------- */
+
+.afy-row__title::before {
+  content: "";
+  display: inline-block;
+  width: 4px;
+  height: 1em;
+  margin-right: 10px;
+  border-radius: 2px;
+  vertical-align: -0.12em;
+  background: linear-gradient(180deg, #ff2e63, #ff9f1c);
+}
+
+/* ---------- Vignettes vidéo ---------- */
+
+.afy-card {
+  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.afy-card:hover {
+  transform: translateY(-5px);
+}
+.afy-card__thumb-wrap {
+  border-radius: 18px;
+  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.28);
+  transition: box-shadow 0.35s ease;
+}
+.afy-card:hover .afy-card__thumb-wrap {
+  box-shadow:
+    0 18px 38px rgba(0, 0, 0, 0.45),
+    0 0 0 1px rgba(255, 46, 99, 0.45),
+    0 0 38px rgba(255, 46, 99, 0.2);
+}
+
+/* ---------- Cartes d'abonnement / chaînes ---------- */
+
+.afy-sub-card {
+  border-radius: 20px;
+  background:
+    linear-gradient(165deg, rgba(124, 92, 255, 0.12) 0%, transparent 55%),
+    color-mix(in srgb, var(--afy-surface-2) 88%, transparent);
+  border-color: rgba(255, 255, 255, 0.1);
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
+  transition:
+    transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
+    border-color 0.3s ease,
+    box-shadow 0.35s ease;
+}
+.afy-sub-card:hover {
+  transform: translateY(-4px);
+  border-color: rgba(124, 92, 255, 0.65);
+  box-shadow:
+    0 18px 38px rgba(0, 0, 0, 0.36),
+    0 0 0 1px rgba(124, 92, 255, 0.3),
+    0 0 36px rgba(124, 92, 255, 0.18);
+}
+
+/* ---------- Puces, boutons, états vides ---------- */
+
+.afy-chip {
+  transition:
+    background 0.25s ease,
+    border-color 0.25s ease,
+    transform 0.25s ease,
+    box-shadow 0.25s ease;
+}
+.afy-chip:hover {
+  transform: translateY(-1px);
+  border-color: rgba(255, 46, 99, 0.55);
+}
+.afy-chip--active {
+  background: linear-gradient(135deg, #ff2e63, #ff9f1c);
+  box-shadow: 0 6px 20px rgba(255, 46, 99, 0.35);
+}
+.afy-btn-secondary {
+  transition:
+    background 0.25s ease,
+    border-color 0.25s ease,
+    transform 0.25s ease;
+}
+.afy-btn-secondary:hover {
+  transform: translateY(-1px);
+  border-color: rgba(124, 92, 255, 0.6);
+}
+.afy-empty {
+  margin: 16px 24px;
+  border-radius: 22px;
+  border: 1px dashed rgba(255, 255, 255, 0.16);
+  background: color-mix(in srgb, var(--afy-surface-1) 60%, transparent);
+}
+
+/* ---------- AetherFy Musique / Vidéo (VaultTubePage) ---------- */
+
+/* Champ de recherche : styles inline d'origine → !important nécessaire */
+.avm-hxp-search input {
+  border-radius: 14px !important;
+  border: 1px solid rgba(255, 255, 255, 0.14) !important;
+  background: rgba(10, 10, 16, 0.55) !important;
+  transition:
+    border-color 0.25s ease,
+    box-shadow 0.25s ease;
+}
+.avm-hxp-search input:focus {
+  border-color: rgba(124, 92, 255, 0.8) !important;
+  box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.22);
+}
+.avm-af-card {
+  transition:
+    transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
+    filter 0.35s ease;
+}
+.avm-af-card:hover {
+  transform: translateY(-5px);
+  filter: drop-shadow(0 16px 26px rgba(0, 0, 0, 0.45)) drop-shadow(0 0 22px rgba(124, 92, 255, 0.3));
+}
+
+@keyframes afy-m-rise {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+}
