@@ -0,0 +1,33 @@
+import { useCallback, useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { errorMessage, musicApi, type MusicTrack } from "./api";
+
+/**
+ * Lance un titre du catalogue : retrouve la bonne vidéo YouTube (version audio
+ * officielle, durée cohérente — mémorisée pour la fois suivante) puis ouvre le
+ * lecteur AetherFy.
+ */
+export function usePlayTrack() {
+  const navigate = useNavigate();
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const play = useCallback(
+    async (track: MusicTrack) => {
+      if (busyId) return;
+      setBusyId(track.id);
+      setError(null);
+      try {
+        const resolution = await musicApi.resolveTrack(track);
+        navigate(`/aetherfy/watch/${resolution.video_id}`);
+      } catch (e) {
+        setError(errorMessage(e, "Impossible de trouver une version à lire pour ce titre."));
+      } finally {
+        setBusyId(null);
+      }
+    },
+    [busyId, navigate]
+  );
+
+  return { play, busyId, error, clearError: () => setError(null) };
+}
