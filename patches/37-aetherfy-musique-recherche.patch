@@ -0,0 +1,75 @@
+import { useEffect, useState } from "react";
+import { useNavigate, useParams } from "react-router-dom";
+import { ArrowLeft } from "lucide-react";
+import { AlbumCard } from "./AlbumCard";
+import { errorMessage, musicApi, type MusicAlbum } from "./api";
+import "./music.css";
+
+const SECTIONS: { kind: string; label: string }[] = [
+  { kind: "album", label: "Albums" },
+  { kind: "ep", label: "EP" },
+  { kind: "single", label: "Singles" },
+];
+
+/** Fiche artiste : discographie (albums, EP, singles) classée du plus récent au plus ancien. */
+export function MusicArtistPage() {
+  const { artistId = "" } = useParams();
+  const navigate = useNavigate();
+  const [albums, setAlbums] = useState<MusicAlbum[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    setAlbums(null);
+    setError(null);
+    musicApi
+      .artistAlbums(artistId)
+      .then((list) => {
+        if (!cancelled) setAlbums(list);
+      })
+      .catch((e) => {
+        if (!cancelled) setError(errorMessage(e, "Discographie indisponible."));
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [artistId]);
+
+  const artistName = albums?.find((a) => a.artist)?.artist ?? "Artiste";
+
+  return (
+    <div className="avm-music-page">
+      <button type="button" className="avm-music-back" onClick={() => navigate(-1)}>
+        <ArrowLeft size={16} aria-hidden="true" /> Retour
+      </button>
+      <h1 className="avm-music-page__title">{artistName}</h1>
+
+      {!albums && !error && <div className="afy-loader">Chargement de la discographie…</div>}
+      {error && (
+        <div className="afy-empty">
+          <div className="afy-empty__title">{error}</div>
+        </div>
+      )}
+      {albums && albums.length === 0 && (
+        <div className="afy-empty">
+          <div className="afy-empty__title">Aucun disque référencé pour cet artiste.</div>
+        </div>
+      )}
+      {albums &&
+        SECTIONS.map(({ kind, label }) => {
+          const list = albums.filter((a) => a.kind === kind);
+          if (list.length === 0) return null;
+          return (
+            <section key={kind} className="avm-music-section">
+              <h2 className="avm-music-section__title">{label}</h2>
+              <div className="avm-music-grid">
+                {list.map((album) => (
+                  <AlbumCard key={album.id} album={album} showArtist={false} />
+                ))}
+              </div>
+            </section>
+          );
+        })}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/features/music/MusicSearchResults.tsx b/apps/desktop/src/features/music/MusicSearchResults.tsx
new file mode 100644
index 0000000..7f34a6c
--- /dev/null
+++ b/apps/desktop/src/features/music/MusicSearchResults.tsx
@@ -0,0 +1,119 @@
+import { useEffect, useState } from "react";
+import { Link } from "react-router-dom";
+import { Mic2 } from "lucide-react";
+import { AlbumCard } from "./AlbumCard";
+import { TrackRow } from "./TrackRow";
+import { errorMessage, musicApi, type MusicSearchKind, type MusicSearchResponse } from "./api";
+import { usePlayTrack } from "./usePlayTrack";
+
+interface MusicSearchResultsProps {
+  query: string;
+  kind: MusicSearchKind;
+}
+
+/** Résultats du catalogue musical pour un type donné (titres, albums, artistes). */
+export function MusicSearchResults({ query, kind }: MusicSearchResultsProps) {
+  const [data, setData] = useState<MusicSearchResponse | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const { play, busyId, error: playError } = usePlayTrack();
+
+  useEffect(() => {
+    if (!query) {
+      setData(null);
+      return;
+    }
+    let cancelled = false;
+    setLoading(true);
+    setError(null);
+    setData(null);
+    musicApi
+      .search(kind, query)
+      .then((response) => {
+        if (!cancelled) setData(response);
+      })
+      .catch((e) => {
+        if (!cancelled) setError(errorMessage(e, "Recherche impossible."));
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [query, kind]);
+
+  if (!query) {
+    return (
+      <div className="afy-empty">
+        <div className="afy-empty__title">Saisissez un artiste, un album ou un titre.</div>
+      </div>
+    );
+  }
+  if (loading) return <div className="afy-loader">Recherche dans le catalogue…</div>;
+  if (error) {
+    return (
+      <div className="afy-empty">
+        <div className="afy-empty__title">{error}</div>
+      </div>
+    );
+  }
+  if (!data) return null;
+
+  const empty = data.tracks.length + data.albums.length + data.artists.length === 0;
+  if (empty) {
+    return (
+      <div className="afy-empty">
+        <div className="afy-empty__title">Aucun résultat pour « {query} ».</div>
+        <p className="avm-music-hint">
+          Essayez « Artiste - Titre », sans faute de frappe, ou l'onglet Vidéos.
+        </p>
+      </div>
+    );
+  }
+
+  return (
+    <div className="avm-music-results">
+      {playError && <div className="avm-music-error">{playError}</div>}
+
+      {kind === "track" && (
+        <div className="avm-music-tracks">
+          {data.tracks.map((track) => (
+            <TrackRow key={track.id} track={track} busy={busyId === track.id} onPlay={play} />
+          ))}
+        </div>
+      )}
+
+      {kind === "album" && (
+        <div className="avm-music-grid">
+          {data.albums.map((album) => (
+            <AlbumCard key={album.id} album={album} />
+          ))}
+        </div>
+      )}
+
+      {kind === "artist" && (
+        <div className="avm-music-artists">
+          {data.artists.map((artist) => {
+            const details = [artist.kind === "Group" ? "Groupe" : artist.kind === "Person" ? "Artiste" : "", artist.country, artist.active_years]
+              .filter(Boolean)
+              .join(" · ");
+            return (
+              <Link key={artist.id} className="avm-music-artist" to={`/aetherfy/music/artist/${artist.id}`}>
+                <span className="avm-music-avatar" aria-hidden="true">
+                  {artist.name.trim().charAt(0).toUpperCase() || <Mic2 size={18} />}
+                </span>
+                <span className="avm-music-track__main">
+                  <span className="avm-music-track__title">{artist.name}</span>
+                  <span className="avm-music-track__sub">
+                    {[artist.disambiguation, details].filter(Boolean).join(" — ")}
+                  </span>
+                </span>
+              </Link>
+            );
+          })}
+        </div>
+      )}
+    </div>
+  );
+}
