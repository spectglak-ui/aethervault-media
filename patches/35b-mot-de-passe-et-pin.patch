diff --git a/apps/desktop/src/features/profile/ProfileSecurityPanel.tsx b/apps/desktop/src/features/profile/ProfileSecurityPanel.tsx
new file mode 100644
index 0000000..2ba9ad8
--- /dev/null
+++ b/apps/desktop/src/features/profile/ProfileSecurityPanel.tsx
@@ -0,0 +1,139 @@
+import { useState } from "react";
+import { Button } from "@aethervault/ui-kit";
+import type { Profile } from "@aethervault/shared-types";
+import { useActiveProfile } from "../../profile/ActiveProfileContext";
+import { profileApi } from "./api";
+import { RecoveryCodeBox } from "./RecoveryCodeBox";
+import { SecretFields } from "./SecretFields";
+import {
+  EMPTY_SECRET_FORM,
+  kindOfProfile,
+  secretLabel,
+  secretPayload,
+  validateSecretForm,
+  type SecretFormState,
+} from "./secret";
+import "./profileSecret.css";
+
+interface ProfileSecurityPanelProps {
+  profile: Profile;
+  /** `true` pour le compte connecté : le secret actuel est alors demandé. Sinon
+   * (administrateur qui gère un autre compte) il est simplement réinitialisé. */
+  isSelf: boolean;
+  onChanged?: () => void;
+}
+
+/**
+ * Définir, changer ou retirer le mot de passe / code PIN d'un compte, après sa
+ * création. Un nouveau secret génère un nouveau code de récupération (l'ancien
+ * n'est plus valable).
+ */
+export function ProfileSecurityPanel({ profile, isSelf, onChanged }: ProfileSecurityPanelProps) {
+  const { refresh } = useActiveProfile();
+  const currentKind = kindOfProfile(profile);
+  const [form, setForm] = useState<SecretFormState>(EMPTY_SECRET_FORM);
+  const [current, setCurrent] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [recoveryCode, setRecoveryCode] = useState<string | null>(null);
+
+  const removing = form.mode === "none";
+  const needsCurrent = isSelf && currentKind !== null;
+
+  const apply = async () => {
+    if (busy) return;
+    setError(null);
+    setNotice(null);
+    if (removing && currentKind === null) {
+      setError("Choisissez un mot de passe ou un code PIN.");
+      return;
+    }
+    const problem = validateSecretForm(form);
+    if (problem) {
+      setError(problem);
+      return;
+    }
+    if (needsCurrent && !current) {
+      setError(`Saisissez votre ${secretLabel(currentKind)} actuel.`);
+      return;
+    }
+    setBusy(true);
+    try {
+      const { secret, kind } = secretPayload(form);
+      const code = isSelf
+        ? await profileApi.changeOwnSecret(needsCurrent ? current : null, secret, kind)
+        : await profileApi.setSecret(profile.id, secret, kind);
+      setForm(EMPTY_SECRET_FORM);
+      setCurrent("");
+      await refresh();
+      onChanged?.();
+      if (code) setRecoveryCode(code);
+      else setNotice("Protection retirée : ce compte s'ouvre sans mot de passe.");
+    } catch (err) {
+      setError(typeof err === "string" ? err : err instanceof Error ? err.message : "Échec de l'enregistrement.");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  if (recoveryCode) {
+    return (
+      <RecoveryCodeBox
+        code={recoveryCode}
+        profileName={profile.name}
+        onDone={() => {
+          setRecoveryCode(null);
+          setNotice("Protection enregistrée.");
+        }}
+      />
+    );
+  }
+
+  return (
+    <div
+      className="avm-secret__panel"
+      onKeyDown={(e) => {
+        // Entrée applique la protection sans valider le formulaire parent.
+        if (e.key === "Enter") {
+          e.preventDefault();
+          void apply();
+        }
+      }}
+    >
+      <p className="avm-secret__status">
+        {currentKind
+          ? `Ce compte est protégé par un ${secretLabel(currentKind)}.`
+          : "Aucune protection : tout le monde peut ouvrir ce compte."}
+      </p>
+
+      {needsCurrent && currentKind && (
+        <label className="avm-form-field">
+          <span>{currentKind === "pin" ? "Code PIN actuel" : "Mot de passe actuel"}</span>
+          <input
+            type="password"
+            inputMode={currentKind === "pin" ? "numeric" : undefined}
+            autoComplete="current-password"
+            value={current}
+            onChange={(e) => setCurrent(e.target.value)}
+          />
+        </label>
+      )}
+
+      <SecretFields value={form} onChange={setForm} allowNone={currentKind !== null} disabled={busy} />
+
+      {error && <p className="avm-settings-error">{error}</p>}
+      {notice && <p className="avm-secret__ok">{notice}</p>}
+
+      <Button type="button" variant="secondary" disabled={busy} onClick={() => void apply()}>
+        {busy
+          ? "Enregistrement…"
+          : removing
+            ? "Retirer la protection"
+            : currentKind
+              ? "Modifier la protection"
+              : "Activer la protection"}
+      </Button>
+    </div>
+  );
+}
diff --git a/apps/desktop/src/features/profile/RecoveryCodeBox.tsx b/apps/desktop/src/features/profile/RecoveryCodeBox.tsx
new file mode 100644
index 0000000..2fee9a1
--- /dev/null
+++ b/apps/desktop/src/features/profile/RecoveryCodeBox.tsx
@@ -0,0 +1,62 @@
+import { useState } from "react";
+import { Check, Copy } from "lucide-react";
+import { Button } from "@aethervault/ui-kit";
+import "./profileSecret.css";
+
+interface RecoveryCodeBoxProps {
+  code: string;
+  onDone: () => void;
+  /** Nom du compte concerné (affiché si plusieurs codes se suivent). */
+  profileName?: string;
+  variant?: "auth" | "form";
+}
+
+/**
+ * Affiche UNE FOIS le code de récupération d'un compte et exige de confirmer qu'on
+ * l'a noté : c'est la seule façon de récupérer l'accès si le secret est oublié.
+ */
+export function RecoveryCodeBox({ code, onDone, profileName, variant = "form" }: RecoveryCodeBoxProps) {
+  const [copied, setCopied] = useState(false);
+  const [ack, setAck] = useState(false);
+
+  const copy = async () => {
+    try {
+      await navigator.clipboard.writeText(code);
+      setCopied(true);
+      window.setTimeout(() => setCopied(false), 2000);
+    } catch {
+      /* copie facultative */
+    }
+  };
+
+  return (
+    <div className="avm-secret__recovery">
+      <h3 className="avm-secret__recovery-title">
+        Code de récupération{profileName ? ` — ${profileName}` : ""}
+      </h3>
+      <p className={variant === "auth" ? "avm-auth__hint" : "avm-secret__hint"}>
+        Conservez ce code précieusement : c'est la seule façon de récupérer l'accès si le mot de passe
+        ou le code PIN est oublié. Il ne sera plus jamais affiché.
+      </p>
+      <div className="avm-secret__code">
+        <code>{code}</code>
+        <button type="button" className="avm-secret__copy" onClick={() => void copy()} aria-label="Copier">
+          {copied ? <Check size={14} /> : <Copy size={14} />}
+        </button>
+      </div>
+      <label className="avm-secret__ack">
+        <input type="checkbox" checked={ack} onChange={(e) => setAck(e.target.checked)} />
+        J'ai noté ce code en lieu sûr
+      </label>
+      {variant === "auth" ? (
+        <button className="avm-btn avm-btn--primary" type="button" disabled={!ack} onClick={onDone}>
+          Continuer
+        </button>
+      ) : (
+        <Button type="button" variant="primary" disabled={!ack} onClick={onDone}>
+          Continuer
+        </Button>
+      )}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/features/profile/SecretFields.tsx b/apps/desktop/src/features/profile/SecretFields.tsx
