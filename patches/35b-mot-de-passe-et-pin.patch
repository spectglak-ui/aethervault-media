+        assert_eq!(set_secret(&conn, id, None, None).unwrap(), None);
+        let r = record(&conn, id);
+        assert!((r.password_hash.is_none(), r.recovery_code_hash.is_none(), r.auth_kind.is_none()) == (true, true, true));
