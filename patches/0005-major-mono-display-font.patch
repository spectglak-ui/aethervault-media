+/* --- Major Mono Display (FONCTIONNALITÉ : ajoutée à la bibliothèque de
+   polices + utilisée pour l'identité visuelle "AetherFy") ---
+   Source : Google Fonts (The Major Mono Project Authors), licence SIL
+   Open Font License 1.1 — texte complet dans
+   ./fonts/MajorMonoDisplay-OFL.txt, conservé à côté du fichier de
+   police comme l'exige l'OFL. Une seule graisse (Regular, 400) : c'est
+   une police d'affichage géométrique, pas destinée au corps de texte. */
+@font-face {
+  font-family: "Major Mono Display";
+  src: url("./fonts/MajorMonoDisplay-Regular.woff2") format("woff2");
+  font-weight: 400;
+  font-style: normal;
+  font-display: swap;
+}
+
+/* Identité "AetherFy" : classe dédiée, indépendante des 4 rôles
+   typographiques (display/ui/body/mono) réglables dans Paramètres →
+   Typographie — le mot "AetherFy" garde toujours Major Mono Display,
+   quel que soit le choix de l'utilisateur pour le reste de l'UI.
+   Espacement des lettres élargi : les polices "mono display"
+   géométriques comme celle-ci sont conçues pour être lues avec de
+   l'air entre les caractères. */
+/* Spécificité #root volontaire : sans ça, les règles de cascade globale
+   juste en dessous (#root *, #root button/nav/label, #root h1-h6) sont
+   plus spécifiques et écraseraient cette police. Utilisation prévue :
+   toujours sur un <span> dédié entourant le seul mot "AetherFy", jamais
+   directement sur un <button>/<nav>/<h1> englobant. */
+#root .avm-brand-aetherfy {
+  font-family: "Major Mono Display", "Space Grotesk", system-ui, sans-serif;
+  font-weight: 400;
+  letter-spacing: 0.04em;
+}
+
