+        ResolveRequest {
+            mbid: Some("11111111-1111-1111-1111-111111111111".into()),
+            artist: "Daft Punk".into(),
+            title: "One More Time".into(),
+            duration_ms: Some(320_000),
+        }
+    }
+
+    fn cand(id: &str, title: &str, channel: &str, duration: Option<i64>) -> Candidate {
+        Candidate { video_id: id.into(), title: title.into(), channel: channel.into(), duration_s: duration }
+    }
+
+    fn id(n: u8) -> String {
+        format!("video{n:06}")
+    }
+
+    #[test]
+    fn l_audio_officiel_bat_le_live_la_reprise_et_le_karaoke() {
+        let r = req();
+        let official = score_candidate(&r, &cand("a", "One More Time", "Daft Punk - Topic", Some(320)));
+        let clip = score_candidate(&r, &cand("b", "Daft Punk - One More Time (Official Video)", "Daft Punk", Some(321)));
+        let live = score_candidate(&r, &cand("c", "Daft Punk - One More Time (Live at Bercy)", "Daft Punk", Some(402)));
+        let cover = score_candidate(&r, &cand("d", "One More Time - Daft Punk cover", "Un Fan", Some(318)));
+        let karaoke = score_candidate(&r, &cand("e", "Daft Punk - One More Time (Karaoke Version)", "KaraokeHits", Some(320)));
+        let sped = score_candidate(&r, &cand("f", "one more time daft punk sped up", "x", Some(200)));
+        assert!(official > clip, "{official} vs {clip}");
+        assert!(clip > live);
+        assert!(official > cover + 0.2);
+        assert!(official > karaoke + 0.2);
+        assert!(official > sped + 0.4);
+        assert!(official >= MIN_CACHE && clip >= MIN_CACHE);
+        assert!(live < MIN_CACHE && cover < MIN_CACHE && karaoke < MIN_CACHE);
+    }
+
+    #[test]
+    fn la_duree_departage_deux_titres_identiques() {
+        let r = req();
+        let close = score_candidate(&r, &cand("a", "Daft Punk - One More Time", "Daft Punk", Some(321)));
+        let far = score_candidate(&r, &cand("b", "Daft Punk - One More Time", "Daft Punk", Some(600)));
+        assert!(close > far + 0.4);
+        // Sans durée connue des deux côtés : pas de bonus ni de malus.
+        let mut no_duration = req();
+        no_duration.duration_ms = None;
+        assert_eq!(
+            score_candidate(&no_duration, &cand("a", "Daft Punk - One More Time", "Daft Punk", Some(321))),
+            score_candidate(&no_duration, &cand("b", "Daft Punk - One More Time", "Daft Punk", Some(600)))
+        );
+    }
+
+    #[test]
+    fn une_variante_demandee_n_est_pas_penalisee() {
+        let r = ResolveRequest { mbid: None, artist: "Daft Punk".into(), title: "One More Time (Live)".into(), duration_ms: None };
+        let live = score_candidate(&r, &cand("c", "Daft Punk - One More Time (Live at Bercy)", "Daft Punk", None));
+        let studio = score_candidate(&r, &cand("a", "Daft Punk - One More Time", "Daft Punk", None));
+        assert!(live >= studio - 0.01);
+        // « Live Forever » n'est pas une variante quand « live » est dans le titre demandé.
+        let oasis = ResolveRequest { mbid: None, artist: "Oasis".into(), title: "Live Forever".into(), duration_ms: Some(276_000) };
+        assert!(score_candidate(&oasis, &cand("o", "Oasis - Live Forever (Remastered)", "Oasis", Some(277))) >= MIN_CACHE);
+    }
+
+    #[test]
+    fn la_cle_de_memorisation_est_stable() {
+        assert_eq!(track_key(Some("abc"), "A", "B"), "mb:abc");
+        assert_eq!(
+            track_key(None, "Étienne Daho", "Week-end à Rome (Remastered)"),
+            track_key(None, "etienne daho", "Week end a Rome")
+        );
+        assert_ne!(track_key(None, "A", "B"), track_key(None, "A", "C"));
+    }
+
+    #[test]
+    fn identifiant_youtube_valide() {
+        assert!(is_youtube_id("dQw4w9WgXcQ"));
+        assert!(is_youtube_id("a-_B1234567"));
+        assert!(!is_youtube_id("dQw4w9WgXc"));
+        assert!(!is_youtube_id("dQw4w9WgXc!"));
+        assert!(!is_youtube_id("https://youtu.be/dQw4w9WgXcQ"));
+    }
+
+    fn db() -> Connection {
+        Connection::open_in_memory().unwrap()
+    }
+
+    #[test]
+    fn resout_memorise_puis_ne_recherche_plus() {
+        let conn = db();
+        let calls = Cell::new(0);
+        let search = |_: &str| -> Result<Vec<Candidate>, String> {
+            calls.set(calls.get() + 1);
+            Ok(vec![
+                cand(&id(1), "Daft Punk - One More Time (Live at Bercy)", "Daft Punk", Some(402)),
+                cand(&id(2), "One More Time", "Daft Punk - Topic", Some(320)),
+                cand(&id(3), "One More Time (Karaoke)", "KaraokeHits", Some(320)),
+            ])
+        };
+        let first = resolve(&conn, &req(), &search).unwrap();
+        assert_eq!(first.video_id, id(2));
+        assert!(!first.cached && !first.verified);
+        assert!(first.confidence >= MIN_CACHE);
+        assert!(!first.alternatives.is_empty());
+        assert_eq!(calls.get(), 1); // la première recherche suffit (confiance élevée)
+
+        let again = resolve(&conn, &req(), &search).unwrap();
+        assert!(again.cached);
+        assert_eq!(again.video_id, id(2));
+        assert_eq!(calls.get(), 1); // aucun nouvel appel réseau
+    }
+
+    #[test]
+    fn le_choix_manuel_remplace_le_choix_automatique() {
+        let conn = db();
+        let search = |_: &str| -> Result<Vec<Candidate>, String> {
+            Ok(vec![cand(&id(2), "One More Time", "Daft Punk - Topic", Some(320))])
+        };
+        let first = resolve(&conn, &req(), &search).unwrap();
+        set_manual_match(&conn, &first.track_key, "dQw4w9WgXcQ").unwrap();
+        let after = resolve(&conn, &req(), &search).unwrap();
+        assert_eq!(after.video_id, "dQw4w9WgXcQ");
+        assert!(after.verified && after.cached);
+        assert!(set_manual_match(&conn, &first.track_key, "pas un id").is_err());
+    }
+
+    #[test]
+    fn seconde_recherche_si_la_premiere_est_mediocre() {
+        let conn = db();
+        let calls = Cell::new(0);
+        let search = |q: &str| -> Result<Vec<Candidate>, String> {
+            calls.set(calls.get() + 1);
+            if q.ends_with("audio") {
+                Ok(vec![cand(&id(9), "One More Time", "Daft Punk - Topic", Some(320))])
+            } else {
+                Ok(vec![cand(&id(1), "Quelqu'un reprend One More Time", "Fan", Some(250))])
+            }
+        };
+        let res = resolve(&conn, &req(), &search).unwrap();
+        assert_eq!(calls.get(), 2);
+        assert_eq!(res.video_id, id(9));
+    }
+
+    #[test]
+    fn resultats_hors_sujet_donnent_une_erreur_et_ne_sont_pas_memorises() {
+        let conn = db();
+        let search = |_: &str| -> Result<Vec<Candidate>, String> {
+            Ok(vec![cand(&id(1), "Tutoriel piano pour débutants", "Prof Piano", Some(900))])
+        };
+        assert!(resolve(&conn, &req(), &search).is_err());
+        assert_eq!(cached(&conn, &track_key(req().mbid.as_deref(), "Daft Punk", "One More Time")).unwrap(), None);
+    }
+
+    #[test]
+    fn une_confiance_moyenne_est_proposee_mais_pas_memorisee() {
+        let conn = db();
+        let mut r = req();
+        r.duration_ms = None;
+        let search = |_: &str| -> Result<Vec<Candidate>, String> {
+            // Bon titre, mais aucune chaîne d'artiste et pas de durée : confiance < 0,6.
+            Ok(vec![cand(&id(4), "One More Time", "Une chaîne", None)])
+        };
+        let res = resolve(&conn, &r, &search).unwrap();
+        assert!(res.confidence >= MIN_ACCEPT && res.confidence < MIN_CACHE);
+        assert_eq!(cached(&conn, &res.track_key).unwrap(), None);
+    }
+
+    #[test]
+    fn une_erreur_reseau_est_renvoyee_sans_resultat() {
+        let conn = db();
+        let search = |_: &str| -> Result<Vec<Candidate>, String> { Err("hors ligne".to_string()) };
+        assert_eq!(resolve(&conn, &req(), &search).unwrap_err(), "hors ligne");
+    }
+}
diff --git a/apps/desktop/src-tauri/src/services/music/text.rs b/apps/desktop/src-tauri/src/services/music/text.rs
new file mode 100644
index 0000000..70b077f
--- /dev/null
+++ b/apps/desktop/src-tauri/src/services/music/text.rs
@@ -0,0 +1,138 @@
+//! Normalisation de texte pour comparer des titres et des noms d'artistes.
+
+use std::collections::HashSet;
+
+/// Minuscules, accents retirés, ponctuation remplacée par des espaces.
+pub fn normalize(input: &str) -> String {
+    let mut out = String::with_capacity(input.len());
+    for c in input.chars() {
+        match c {
+            'à' | 'á' | 'â' | 'ã' | 'ä' | 'å' | 'À' | 'Á' | 'Â' | 'Ã' | 'Ä' | 'Å' => out.push('a'),
+            'ç' | 'Ç' => out.push('c'),
+            'è' | 'é' | 'ê' | 'ë' | 'È' | 'É' | 'Ê' | 'Ë' => out.push('e'),
+            'ì' | 'í' | 'î' | 'ï' | 'Ì' | 'Í' | 'Î' | 'Ï' => out.push('i'),
+            'ñ' | 'Ñ' => out.push('n'),
+            'ò' | 'ó' | 'ô' | 'õ' | 'ö' | 'ø' | 'Ò' | 'Ó' | 'Ô' | 'Õ' | 'Ö' | 'Ø' => out.push('o'),
+            'ù' | 'ú' | 'û' | 'ü' | 'Ù' | 'Ú' | 'Û' | 'Ü' => out.push('u'),
+            'ý' | 'ÿ' | 'Ý' => out.push('y'),
+            'œ' | 'Œ' => out.push_str("oe"),
+            'æ' | 'Æ' => out.push_str("ae"),
+            'ß' => out.push_str("ss"),
+            c if c.is_alphanumeric() => out.extend(c.to_lowercase()),
+            _ => out.push(' '),
+        }
+    }
+    out.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+pub fn tokens(input: &str) -> Vec<String> {
+    normalize(input).split(' ').filter(|t| !t.is_empty()).map(str::to_string).collect()
+}
+
+pub fn token_set(input: &str) -> HashSet<String> {
+    tokens(input).into_iter().collect()
+}
+
+/// Part (0–1) des mots de `wanted` retrouvés dans `haystack` — un mot de 3
+/// lettres ou plus compte aussi s'il n'est que le début d'un mot (saisie en cours).
+pub fn coverage(wanted: &[String], haystack: &HashSet<String>) -> f64 {
+    if wanted.is_empty() {
+        return 0.0;
+    }
+    let found = wanted
+        .iter()
+        .filter(|w| {
+            haystack.contains(*w) || (w.chars().count() >= 3 && haystack.iter().any(|h| h.starts_with(w.as_str())))
+        })
+        .count();
+    found as f64 / wanted.len() as f64
+}
+
+/// Retire les mentions entre parenthèses ou crochets (« (Remastered 2011) »,
+/// « [Official Video] ») pour comparer le titre « nu ».
+pub fn strip_decorations(title: &str) -> String {
+    let mut out = String::with_capacity(title.len());
+    let mut depth = 0usize;
+    for c in title.chars() {
+        match c {
+            '(' | '[' => depth += 1,
+            ')' | ']' => depth = depth.saturating_sub(1),
+            _ if depth == 0 => out.push(c),
+            _ => {}
+        }
+    }
+    let trimmed = out.trim();
+    if trimmed.is_empty() { title.trim().to_string() } else { trimmed.to_string() }
+}
+
+/// Mots signalant une version « autre » que l'enregistrement d'origine.
+pub const VARIANT_WORDS: &[&str] = &[
+    "live", "remix", "karaoke", "instrumental", "acoustic", "demo", "cover", "tribute", "slowed",
+    "sped", "reverb", "nightcore", "mashup", "medley", "reprise",
+];
+
+/// Mots de variante présents dans `text` (triés, sans doublon).
+pub fn variants_in(text: &str) -> Vec<&'static str> {
+    let set = token_set(text);
+    let mut found: Vec<&'static str> = VARIANT_WORDS.iter().copied().filter(|w| set.contains(*w)).collect();
+    found.sort_unstable();
+    found
+}
+
+/// `true` si `id` a la forme d'un MBID (UUID) — évite d'injecter du texte libre
+/// dans une URL d'API.
+pub fn is_mbid(id: &str) -> bool {
+    id.len() == 36
+        && id.char_indices().all(|(i, c)| match i {
+            8 | 13 | 18 | 23 => c == '-',
+            _ => c.is_ascii_hexdigit(),
+        })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn normalise_accents_casse_et_ponctuation() {
+        assert_eq!(normalize("  Étienne Daho — Week-end à Rome! "), "etienne daho week end a rome");
+        assert_eq!(normalize("Mylène Farmer ‑ Désenchantée"), "mylene farmer desenchantee");
+        assert_eq!(normalize("Cœur de pirate"), "coeur de pirate");
+        assert_eq!(normalize("AC/DC"), "ac dc");
+    }
+
+    #[test]
+    fn couverture_des_mots_avec_debut_de_mot() {
+        let hay = token_set("Daft Punk One More Time");
+        assert_eq!(coverage(&tokens("daft punk one more time"), &hay), 1.0);
+        assert_eq!(coverage(&tokens("daft punk"), &hay), 1.0);
+        assert_eq!(coverage(&tokens("daft punk harder"), &hay), 2.0 / 3.0);
+        // saisie en cours : « dis » est le début de « discovery »
+        assert_eq!(coverage(&tokens("dis"), &token_set("Discovery")), 1.0);
+        // un mot de 2 lettres doit être exact
+        assert_eq!(coverage(&tokens("on"), &token_set("one")), 0.0);
+        assert_eq!(coverage(&[], &hay), 0.0);
+    }
+
+    #[test]
+    fn retire_les_mentions_entre_parentheses() {
+        assert_eq!(strip_decorations("One More Time (Remastered 2011)"), "One More Time");
+        assert_eq!(strip_decorations("Song [Official Video] (feat. X)"), "Song");
+        assert_eq!(strip_decorations("(Untitled)"), "(Untitled)");
+    }
+
+    #[test]
+    fn detecte_les_variantes() {
+        assert_eq!(variants_in("One More Time (Live at Bercy)"), vec!["live"]);
+        assert_eq!(variants_in("Song - Remix Acoustic"), vec!["acoustic", "remix"]);
+        assert!(variants_in("One More Time").is_empty());
+    }
+
+    #[test]
+    fn reconnait_un_mbid() {
+        assert!(is_mbid("3bd76d40-7f0e-36b7-9348-91a33afee20e"));
+        assert!(!is_mbid("3bd76d40-7f0e-36b7-9348-91a33afee20"));
+        assert!(!is_mbid("../../etc/passwd"));
+        assert!(!is_mbid("3bd76d40-7f0e-36b7-9348-91a33afee20z"));
+    }
+}
diff --git a/apps/desktop/src-tauri/src/services/music/web.rs b/apps/desktop/src-tauri/src/services/music/web.rs
new file mode 100644
index 0000000..6513293
--- /dev/null
+++ b/apps/desktop/src-tauri/src/services/music/web.rs
@@ -0,0 +1,198 @@
+//! Recherches YouTube complémentaires du catalogue : playlists et livres audio.
+//!
+//! La recherche texte de base (`ytsearch`) ne renvoie que des vidéos. Les
+//! playlists s'obtiennent avec le filtre « Playlist » des résultats YouTube
+//! (paramètre `sp`), que yt-dlp sait lire ; les livres audio sont des vidéos
+//! longues retrouvées par mots-clés. L'analyse des réponses est séparée du
+//! lancement de yt-dlp pour être testée sans réseau.
+
+use serde_json::Value;
+
+use crate::services::vaulttube::models::SearchResult;
+
+/// Filtre « Type : Playlist » des résultats de recherche YouTube.
+const PLAYLIST_FILTER: &str = "EgIQAw%253D%253D";
+/// Un livre audio dure au moins 30 minutes.
+pub const AUDIOBOOK_MIN_SECONDS: i64 = 30 * 60;
+
+fn percent_encode(input: &str) -> String {
+    let mut out = String::with_capacity(input.len() * 3);
+    for b in input.bytes() {
+        match b {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => out.push(b as char),
+            _ => out.push_str(&format!("%{b:02X}")),
+        }
+    }
+    out
+}
+
+/// Adresse de la recherche YouTube limitée aux playlists.
+pub fn playlist_search_url(query: &str) -> String {
+    format!(
+        "https://www.youtube.com/results?search_query={}&sp={PLAYLIST_FILTER}",
+        percent_encode(query.trim())
+    )
+}
+
+/// Playlists « réelles » : listes d'utilisateurs (`PL…`), albums YouTube Music
+/// (`OLAK5uy…`) et favoris publics (`FL…`). Les « mixes » (`RD…`), générés à la
+/// volée et sans contenu fixe, sont ignorés.
+fn is_playlist_id(id: &str) -> bool {
+    ["PL", "OLAK5uy", "FL"].iter().any(|p| id.starts_with(p))
+}
+
+fn thumbnail(entry: &Value) -> Option<String> {
+    entry
+        .get("thumbnail")
+        .and_then(Value::as_str)
+        .map(str::to_string)
+        .or_else(|| {
+            entry
+                .get("thumbnails")
+                .and_then(Value::as_array)
+                .and_then(|list| list.last())
+                .and_then(|t| t.get("url"))
+                .and_then(Value::as_str)
+                .map(str::to_string)
+        })
+}
+
+/// Interprète une ligne JSON (`--flat-playlist --dump-json`) de la recherche de
+/// playlists ; `None` si ce n'est pas une playlist exploitable.
+pub fn parse_playlist_line(line: &str) -> Option<SearchResult> {
+    let entry: Value = serde_json::from_str(line).ok()?;
+    let id = entry.get("id")?.as_str()?;
+    let title = entry.get("title")?.as_str()?.trim();
+    if id.is_empty() || title.is_empty() || !is_playlist_id(id) {
+        return None;
+    }
+    let url = entry
+        .get("url")
+        .and_then(Value::as_str)
+        .filter(|u| u.contains("list="))
+        .map(str::to_string)
+        .unwrap_or_else(|| format!("https://www.youtube.com/playlist?list={id}"));
+    let count = ["playlist_count", "video_count", "n_entries"]
+        .iter()
+        .find_map(|k| entry.get(*k).and_then(Value::as_i64))
+        .filter(|n| *n > 0);
+    Some(SearchResult {
+        id: id.to_string(),
+        title: title.to_string(),
+        url,
+        kind: "playlist".to_string(),
+        thumbnail_url: thumbnail(&entry),
+        channel: entry
+            .get("uploader")
+            .or_else(|| entry.get("channel"))
+            .and_then(Value::as_str)
+            .filter(|s| !s.is_empty())
+            .map(str::to_string),
+        duration_seconds: None,
+        video_count: count,
+        source: "youtube".to_string(),
+    })
+}
+
+/// Toutes les playlists d'une sortie de yt-dlp (une entrée JSON par ligne), sans doublon.
+pub fn parse_playlist_lines(output: &str) -> Vec<SearchResult> {
+    let mut seen = std::collections::HashSet::new();
+    output
+        .lines()
+        .filter_map(parse_playlist_line)
+        .filter(|r| seen.insert(r.id.clone()))
+        .collect()
+}
+
+/// Ne garde que les vidéos assez longues pour être des livres audio.
+pub fn keep_audiobooks(results: Vec<SearchResult>) -> Vec<SearchResult> {
+    let mut seen = std::collections::HashSet::new();
+    results
+        .into_iter()
+        .filter(|r| r.kind == "video" && r.duration_seconds.is_some_and(|d| d >= AUDIOBOOK_MIN_SECONDS))
+        .filter(|r| seen.insert(r.id.clone()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn video(id: &str, seconds: Option<i64>, kind: &str) -> SearchResult {
+        SearchResult {
+            id: id.into(),
+            title: format!("Titre {id}"),
+            url: format!("https://www.youtube.com/watch?v={id}"),
+            kind: kind.into(),
+            thumbnail_url: None,
+            channel: None,
+            duration_seconds: seconds,
+            video_count: None,
+            source: "youtube".into(),
+        }
+    }
+
+    #[test]
+    fn construit_l_adresse_de_recherche_de_playlists() {
+        assert_eq!(
+            playlist_search_url("  chain of the abyss "),
+            "https://www.youtube.com/results?search_query=chain%20of%20the%20abyss&sp=EgIQAw%253D%253D"
+        );
+        assert!(playlist_search_url("AC/DC & co").contains("search_query=AC%2FDC%20%26%20co&"));
+    }
+
+    #[test]
+    fn analyse_une_playlist_complete() {
+        let line = r#"{"id":"PLabc123","title":"Made in Abyss OST","url":"https://www.youtube.com/playlist?list=PLabc123","uploader":"Hecate Music","playlist_count":24,"thumbnails":[{"url":"https://i.ytimg.com/a.jpg"},{"url":"https://i.ytimg.com/b.jpg"}]}"#;
+        let r = parse_playlist_line(line).expect("playlist");
+        assert_eq!(r.id, "PLabc123");
+        assert_eq!(r.kind, "playlist");
+        assert_eq!(r.url, "https://www.youtube.com/playlist?list=PLabc123");
+        assert_eq!(r.channel.as_deref(), Some("Hecate Music"));
+        assert_eq!(r.video_count, Some(24));
+        assert_eq!(r.thumbnail_url.as_deref(), Some("https://i.ytimg.com/b.jpg")); // la plus grande (dernière)
+        assert_eq!(r.source, "youtube");
+    }
+
+    #[test]
+    fn reconstruit_l_url_et_accepte_les_albums_youtube_music() {
+        let r = parse_playlist_line(r#"{"id":"OLAK5uy_xyz","title":"Album","thumbnail":"https://i/x.jpg"}"#).unwrap();
+        assert_eq!(r.url, "https://www.youtube.com/playlist?list=OLAK5uy_xyz");
+        assert_eq!(r.thumbnail_url.as_deref(), Some("https://i/x.jpg"));
+        assert_eq!(r.video_count, None);
+        // L'adresse d'une vidéo sans « list= » n'est pas reprise telle quelle.
+        let r = parse_playlist_line(r#"{"id":"PLz","title":"T","url":"https://www.youtube.com/watch?v=abc"}"#).unwrap();
+        assert_eq!(r.url, "https://www.youtube.com/playlist?list=PLz");
+    }
+
+    #[test]
+    fn ignore_ce_qui_n_est_pas_une_playlist() {
+        assert!(parse_playlist_line(r#"{"id":"dQw4w9WgXcQ","title":"Une vidéo"}"#).is_none());
+        assert!(parse_playlist_line(r#"{"id":"RDabc","title":"Mix YouTube"}"#).is_none());
+        assert!(parse_playlist_line(r#"{"id":"PLabc","title":"  "}"#).is_none());
+        assert!(parse_playlist_line(r#"{"title":"Sans id"}"#).is_none());
+        assert!(parse_playlist_line("pas du json").is_none());
+        assert!(parse_playlist_line("").is_none());
+    }
+
+    #[test]
+    fn analyse_plusieurs_lignes_sans_doublon() {
+        let out = "{\"id\":\"PL1\",\"title\":\"A\"}\n\n{\"id\":\"RD9\",\"title\":\"Mix\"}\n{\"id\":\"PL1\",\"title\":\"A bis\"}\n{\"id\":\"PL2\",\"title\":\"B\"}\n";
+        let ids: Vec<String> = parse_playlist_lines(out).into_iter().map(|r| r.id).collect();
+        assert_eq!(ids, vec!["PL1", "PL2"]);
+    }
+
+    #[test]
+    fn les_livres_audio_sont_des_videos_longues() {
+        let kept = keep_audiobooks(vec![
+            video("a", Some(3600), "video"),
+            video("b", Some(240), "video"),
+            video("c", None, "video"),
+            video("d", Some(7200), "playlist"),
+            video("a", Some(3600), "video"),
+            video("e", Some(AUDIOBOOK_MIN_SECONDS), "video"),
+        ]);
+        let ids: Vec<&str> = kept.iter().map(|r| r.id.as_str()).collect();
+        assert_eq!(ids, vec!["a", "e"]);
+    }
+}
