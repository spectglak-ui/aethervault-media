diff --git a/apps/desktop/src/features/music/usePlayTrack.ts b/apps/desktop/src/features/music/usePlayTrack.ts
new file mode 100644
index 0000000..a6dce44
--- /dev/null
+++ b/apps/desktop/src/features/music/usePlayTrack.ts
@@ -0,0 +1,45 @@
+import { useCallback, useState } from "react";
+import { usePlayer } from "../../player/PlayerContext";
+import { watchUrl } from "../vaulttube/api";
+import { errorMessage, musicApi, type MusicTrack } from "./api";
+
+/**
+ * Lance un titre du catalogue dans le lecteur audio : retrouve la bonne vidéo
+ * YouTube (version audio officielle, durée cohérente — le choix est mémorisé pour
+ * la fois suivante) puis l'envoie à la file de lecture.
+ */
+export function usePlayTrack() {
+  const { playQueue } = usePlayer();
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const play = useCallback(
+    async (track: MusicTrack) => {
+      if (busyId) return;
+      setBusyId(track.id);
+      setError(null);
+      try {
+        const resolution = await musicApi.resolveTrack(track);
+        playQueue(
+          [
+            {
+              id: 0,
+              title: `${track.title} — ${track.artist}`,
+              path: watchUrl("youtube", resolution.video_id),
+              libraryId: -1,
+              mode: "audio",
+            },
+          ],
+          0
+        );
+      } catch (e) {
+        setError(errorMessage(e, "Impossible de trouver une version à lire pour ce titre."));
+      } finally {
+        setBusyId(null);
+      }
+    },
+    [busyId, playQueue]
+  );
+
+  return { play, busyId, error, clearError: () => setError(null) };
+}
diff --git a/apps/desktop/src/features/vaulttube/followMode.ts b/apps/desktop/src/features/vaulttube/followMode.ts
new file mode 100644
index 0000000..33c5654
--- /dev/null
+++ b/apps/desktop/src/features/vaulttube/followMode.ts
@@ -0,0 +1,23 @@
+import { vaultTubeApi, type VaultTubeSubscription } from "./api";
+
+type PlaybackMode = VaultTubeSubscription["mode"];
+
+/**
+ * Suit une chaîne ou une playlist DANS le mode de la page courante.
+ *
+ * Le backend devine le mode d'un abonnement d'après son adresse : une playlist
+ * YouTube ordinaire reste en mode « vidéo ». La page Musique n'affichant que les
+ * abonnements en mode « audio », la playlist ajoutée depuis la page Musique
+ * n'apparaissait jamais dans « Abonnements ». On force donc le mode voulu.
+ */
+export async function addSubscriptionInMode(
+  url: string,
+  mode: PlaybackMode | undefined
+): Promise<VaultTubeSubscription> {
+  const subscription = await vaultTubeApi.addSubscription(url);
+  if (mode && subscription.mode !== mode) {
+    await vaultTubeApi.setSubscriptionMode(subscription.id, mode);
+    return { ...subscription, mode };
+  }
+  return subscription;
+}
