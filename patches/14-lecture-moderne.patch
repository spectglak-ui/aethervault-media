+++ b/apps/desktop/src/pages/reading-modern.css
@@ -0,0 +1,16 @@
+/* ==========================================================================
+   Lecture — survol des cartes (couvertures, bibliothèques) dans le style de
+   l'accueil. Les cartes sont stylées en ligne : on n'ajoute que des effets
+   de survol (transform/filter), jamais de mise en page.
+   ========================================================================== */
+
+.avm-hxr-card {
+  transition:
+    transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
+    filter 0.35s ease;
+}
+.avm-hxr-card:hover,
+.avm-hxr-card:focus-visible {
+  transform: translateY(-5px);
+  filter: drop-shadow(0 16px 26px rgba(0, 0, 0, 0.45)) drop-shadow(0 0 22px rgba(245, 158, 11, 0.28));
+}
