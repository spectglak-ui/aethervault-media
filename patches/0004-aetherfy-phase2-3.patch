+  min-width: 0;
+}
+.avm-af-track__title {
+  font-size: 13px;
+  font-weight: 600;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.avm-af-track__subtitle {
+  font-size: 11px;
+  color: var(--color-text-muted, #9a9aa3);
