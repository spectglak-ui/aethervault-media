+  text-overflow: ellipsis;
+  margin-top: 2px;
+}
+.avm-af-track__duration {
+  font-size: 12px;
+  color: var(--color-text-muted, #9a9aa3);
+  font-variant-numeric: tabular-nums;
+}
+.avm-af-track__actions {
+  display: flex;
+  gap: 2px;
+  opacity: 0;
+  transition: opacity 0.12s ease;
+}
+.avm-af-track:hover .avm-af-track__actions {
+  opacity: 1;
+}
