+/// Position à partir de laquelle le média est « Vu » : le point d'arrêt calculé
+/// (`finish_point`) ramené dans la fenêtre 80 %–90 % de la durée.
+pub fn seen_point(duration: f64, finish_point: f64) -> f64 {
+    finish_point.clamp(duration * SEEN_MIN_RATIO, duration * SEEN_MAX_RATIO)
