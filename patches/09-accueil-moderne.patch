+import type { CSSProperties, MouseEvent, ReactNode } from "react";
+import { useNavigate } from "react-router-dom";
+import { ArrowUpRight, Tv } from "lucide-react";
+import type { Category } from "@aethervault/shared-types";
+import { assetUrl } from "../../lib/assetUrl";
+import { categoryIcon } from "../../lib/categoryIcon";
+import { categoryRoute } from "../../lib/categoryRoute";
+import { CountUp } from "./CountUp";
+import { tintFor } from "./homeTheme";
+
+/** 0.4.0 : détection tolérante de la catégorie Animés. */
+function isAnimeCategory(c: Category): boolean {
+  return c.key === "animes" || c.key === "anime" || c.name.toLowerCase().includes("anim");
+}
+
+interface Portal {
+  id: string;
+  route: string;
+  name: string;
+  tint: string;
+  icon: ReactNode;
+  /** Grande icône décorative affichée quand il n'y a pas de bannière. */
+  ghost?: ReactNode;
+  banner?: string;
+  /** `undefined` : pas de compteur ; `null` : catégorie verrouillée (Privé). */
+  count?: number | null;
+  subtitle?: string;
+  badge?: string;
+  variant?: "aetherfy" | "tv";
+}
+
+function buildPortals(categories: Category[], hidePrivate: boolean): Portal[] {
+  const aetherfy: Portal = {
+    id: "aetherfy",
+    route: "/vaulttube",
+    name: "AetherFy",
+    tint: tintFor("aetherfy"),
+    icon: null,
+    subtitle: "Streaming en ligne",
+    badge: "Alpha",
+    variant: "aetherfy",
+  };
+  const tv: Portal = {
+    id: "tv",
+    route: "/tv",
+    name: "TV",
+    tint: tintFor("tv"),
+    icon: <Tv size={18} />,
+    ghost: <Tv size={120} />,
+    subtitle: "Chaînes en direct",
+    variant: "tv",
+  };
+
+  // Tuile TV : après Privé, ou à la place d'une éventuelle catégorie « tv »
+  // (même règle qu'avant la refonte) ; sinon en dernier recours à la fin.
+  const hasTvCategory = categories.some((c) => c.key === "tv");
+  const out: Portal[] = [];
+  let tvPlaced = false;
+  const placeTv = () => {
+    if (!tvPlaced) {
+      out.push(tv);
+      tvPlaced = true;
+    }
+  };
+  for (const category of categories) {
+    if (category.key === "tv") {
+      placeTv();
+      continue;
+    }
+    if (!(category.key === "private" && hidePrivate)) {
+      out.push({
+        id: `category-${category.id}`,
+        route: categoryRoute(category),
+        name: category.name,
+        tint: tintFor(category.key),
+        icon: categoryIcon(category.key, 18),
+        ghost: categoryIcon(category.key, 120),
+        banner: assetUrl(category.banner) ?? undefined,
+        count: category.title_count,
+      });
+    }
+    if (isAnimeCategory(category)) out.push(aetherfy);
+    if (category.key === "private" && !hasTvCategory) placeTv();
+  }
+  if (!categories.some(isAnimeCategory)) out.push(aetherfy);
+  placeTv();
+  return out;
+}
+
+/**
+ * « Vos univers » : les fonctionnalités principales sous forme de
+ * portails — catégories (avec leur bannière), AetherFy et TV. Mêmes
+ * destinations qu'avant ; Privé reste masquable depuis les Paramètres.
+ */
+export function HomeUniverses({
+  categories,
+  hidePrivate,
+}: {
+  categories: Category[];
+  hidePrivate: boolean;
+}) {
+  const navigate = useNavigate();
+  const portals = buildPortals(categories, hidePrivate);
+
+  // Projecteur qui suit le curseur (variables lues par la feuille de style).
+  const trackPointer = (e: MouseEvent<HTMLButtonElement>) => {
+    const rect = e.currentTarget.getBoundingClientRect();
+    e.currentTarget.style.setProperty("--mx", `${e.clientX - rect.left}px`);
+    e.currentTarget.style.setProperty("--my", `${e.clientY - rect.top}px`);
+  };
+
+  return (
+    <section className="avm-hx-section" aria-label="Vos univers">
+      <div className="avm-hx-head">
+        <span className="avm-hx-kicker">Naviguer</span>
+        <h2>Vos univers</h2>
+      </div>
+      <div className="avm-hx-universes">
+        {portals.map((portal) => (
+          <button
+            key={portal.id}
+            type="button"
+            className={`avm-hx-portal${portal.variant ? ` avm-hx-portal--${portal.variant}` : ""}`}
+            style={{ "--tint": portal.tint } as CSSProperties}
+            onMouseMove={trackPointer}
+            onClick={() => navigate(portal.route)}
+          >
+            {portal.banner ? (
+              <img className="avm-hx-portal__img" src={portal.banner} alt="" loading="lazy" />
+            ) : (
+              <span className="avm-hx-portal__ghost" aria-hidden="true">
+                {portal.ghost}
+              </span>
+            )}
+            {portal.variant === "aetherfy" && (
+              <span className="avm-hx-portal__waves" aria-hidden="true">
+                <span />
+                <span />
+                <span />
+              </span>
+            )}
+            <span className="avm-hx-portal__shade" aria-hidden="true" />
+
+            <span className="avm-hx-portal__top">
+              {portal.icon && <span className="avm-hx-portal__chip">{portal.icon}</span>}
+              {portal.badge && <span className="avm-hx-portal__badge">{portal.badge}</span>}
+              <ArrowUpRight className="avm-hx-portal__arrow" size={18} aria-hidden="true" />
+            </span>
+
+            <span className="avm-hx-portal__bottom">
+              <span className="avm-hx-portal__name">
+                {portal.variant === "aetherfy" ? (
+                  <span className="avm-brand-aetherfy">AetherFy</span>
+                ) : (
+                  portal.name
+                )}
+              </span>
+              <span className="avm-hx-portal__count">
+                {portal.subtitle ??
+                  (portal.count === null || portal.count === undefined ? (
+                    "🔒"
+                  ) : (
+                    <>
+                      <CountUp value={portal.count} /> titre{portal.count > 1 ? "s" : ""}
+                    </>
+                  ))}
+              </span>
+            </span>
+          </button>
+        ))}
+      </div>
+    </section>
+  );
+}
diff --git a/apps/desktop/src/pages/home/HomeWelcome.tsx b/apps/desktop/src/pages/home/HomeWelcome.tsx
new file mode 100644
index 0000000..94b1558
--- /dev/null
+++ b/apps/desktop/src/pages/home/HomeWelcome.tsx
@@ -0,0 +1,30 @@
+import { useActiveProfile } from "../../profile/ActiveProfileContext";
+
+/** Bandeau d'accueil : salutation selon l'heure + date du jour. */
+export function HomeWelcome() {
+  const { activeProfile } = useActiveProfile();
+  const now = new Date();
+  const hour = now.getHours();
+  const greeting =
+    hour >= 5 && hour < 12 ? "Bonjour" : hour >= 12 && hour < 18 ? "Bon après-midi" : "Bonsoir";
+  const date = now.toLocaleDateString("fr-FR", {
+    weekday: "long",
+    day: "numeric",
+    month: "long",
+  });
+
+  return (
+    <div className="avm-hx-welcome">
+      <span className="avm-hx-kicker">{date}</span>
+      <div className="avm-hx-welcome__title">
+        {greeting}
+        {activeProfile ? (
+          <>
+            , <span className="avm-hx-welcome__name">{activeProfile.name}</span>
+          </>
+        ) : null}
+      </div>
+      <span className="avm-hx-welcome__sub">Votre univers, prêt à être exploré.</span>
+    </div>
+  );
+}
diff --git a/apps/desktop/src/pages/home/home-modern.css b/apps/desktop/src/pages/home/home-modern.css
new file mode 100644
index 0000000..0da5c1f
--- /dev/null
+++ b/apps/desktop/src/pages/home/home-modern.css
@@ -0,0 +1,669 @@
+/* ==========================================================================
+   Accueil moderne — même langage visuel que la page de transition AetherFy
+   (verre sombre, teintes par univers, projecteur qui suit le curseur,
+   mot-symbole Major Mono). Tout est scopé sous `.avm-hx` : aucune autre
+   page n'est affectée. Les états de départ des animations sont toujours
+   l'état FINAL visible (si `prefers-reduced-motion` coupe les animations,
+   voir global.css, rien ne reste caché).
+   ========================================================================== */
+
+.avm-hx {
+  isolation: isolate;
+}
+
+/* Lueurs d'ambiance derrière le contenu (fond transparent : le fond du
+   logiciel reste visible). */
+.avm-hx::before {
+  content: "";
+  position: absolute;
+  inset: -2rem -2rem auto -2rem;
+  height: 640px;
+  z-index: -1;
+  pointer-events: none;
+  background:
+    radial-gradient(34% 55% at 18% 8%, rgba(124, 92, 255, 0.2), transparent 70%),
+    radial-gradient(30% 50% at 82% 14%, rgba(236, 72, 153, 0.12), transparent 70%),
+    radial-gradient(30% 50% at 55% 40%, rgba(46, 196, 182, 0.08), transparent 70%);
+}
+
+.avm-hx-kicker {
+  font-size: 11px;
+  letter-spacing: 0.22em;
+  text-transform: uppercase;
+  color: var(--color-text-muted, #9a9aa3);
+}
+.avm-hx-muted {
+  color: var(--color-text-muted, #9a9aa3);
+  font-size: 12px;
+  font-weight: 500;
+}
+
+/* ---------- Bandeau de bienvenue ---------- */
+
+.avm-hx-welcome {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-bottom: 1.4rem;
+  animation: avm-hx-rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+.avm-hx-welcome__title {
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: clamp(26px, 3.2vw, 40px);
+  line-height: 1.1;
+}
+#root .avm-hx-welcome__title {
+  font-family: var(--font-display);
+  font-weight: 800;
+}
+.avm-hx-welcome__name {
+  background: linear-gradient(90deg, #c4b5ff, #7c5cff 55%, #ec4899);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.avm-hx-welcome__sub {
+  font-size: 14px;
+  color: var(--color-text-muted, #9a9aa3);
+}
+
+/* ---------- « À la une » ---------- */
+
+.avm-hx .avm-home-hero {
+  height: clamp(300px, 42vh, 420px);
+  border-radius: 22px;
+  border-color: rgba(255, 255, 255, 0.1);
+  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
+  margin-bottom: 2.2rem;
+  animation: avm-hx-rise 0.7s 0.08s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+.avm-hx .avm-home-hero::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: radial-gradient(60% 90% at 0% 100%, rgba(124, 92, 255, 0.35), transparent 70%);
+}
+.avm-hx .avm-home-hero__content {
+  z-index: 1;
+  padding: 1.6rem 1.8rem;
+}
+.avm-hx-pill {
+  padding: 3px 12px;
+  border-radius: 999px;
+  font-size: 10px;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  background: rgba(255, 255, 255, 0.12);
+  border: 1px solid rgba(255, 255, 255, 0.28);
+  color: #fff;
+}
+
+/* ---------- Titres de section ---------- */
+
+.avm-hx-section {
+  margin-bottom: 2.4rem;
+}
+.avm-hx-head {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin-bottom: 14px;
+}
+.avm-hx-head h2 {
+  margin: 0;
+  font-size: 1.35rem;
+}
+
+/* ---------- Portails (« Vos univers ») ---------- */
+
+.avm-hx-universes {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
+  gap: 16px;
+}
+
+.avm-hx-portal {
+  --mx: 50%;
+  --my: 30%;
+  position: relative;
+  aspect-ratio: 16 / 10;
+  overflow: hidden;
+  padding: 0;
+  display: block;
+  text-align: left;
+  color: #fff;
+  cursor: pointer;
+  appearance: none;
+  border-radius: 20px;
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  background: linear-gradient(165deg, rgba(var(--tint), 0.35), #0e0e14 75%);
+  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.32);
+  transition:
+    transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
+    border-color 0.3s ease,
+    box-shadow 0.35s ease;
+  animation: avm-hx-rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+.avm-hx-portal:nth-child(2) { animation-delay: 0.05s; }
+.avm-hx-portal:nth-child(3) { animation-delay: 0.1s; }
+.avm-hx-portal:nth-child(4) { animation-delay: 0.15s; }
+.avm-hx-portal:nth-child(5) { animation-delay: 0.2s; }
+.avm-hx-portal:nth-child(6) { animation-delay: 0.25s; }
+.avm-hx-portal:nth-child(n + 7) { animation-delay: 0.3s; }
+
+.avm-hx-portal__img {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  filter: saturate(1.1) brightness(0.62);
+  transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.avm-hx-portal__ghost {
+  position: absolute;
+  right: -10px;
+  bottom: -14px;
+  color: rgba(var(--tint), 0.22);
+  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.avm-hx-portal__shade {
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(360px circle at var(--mx) var(--my), rgba(var(--tint), 0.32), transparent 65%),
+    linear-gradient(to top, rgba(8, 8, 12, 0.88) 0%, rgba(8, 8, 12, 0.1) 62%),
+    linear-gradient(165deg, rgba(var(--tint), 0.28), transparent 55%);
+}
+
+.avm-hx-portal:hover,
+.avm-hx-portal:focus-visible {
+  transform: translateY(-5px);
+  border-color: rgba(var(--tint), 0.7);
+  box-shadow:
+    0 24px 56px rgba(0, 0, 0, 0.45),
+    0 0 0 1px rgba(var(--tint), 0.35),
+    0 0 56px rgba(var(--tint), 0.22);
+}
+.avm-hx-portal:focus-visible {
+  outline: 2px solid rgba(var(--tint), 0.9);
+  outline-offset: 3px;
+}
+.avm-hx-portal:hover .avm-hx-portal__img {
+  transform: scale(1.07);
+}
+.avm-hx-portal:hover .avm-hx-portal__ghost {
+  transform: scale(1.08) rotate(-4deg);
+}
+
+.avm-hx-portal__top {
+  position: absolute;
+  top: 14px;
+  left: 14px;
+  right: 14px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.avm-hx-portal__chip {
+  width: 34px;
+  height: 34px;
+  display: grid;
+  place-items: center;
+  border-radius: 10px;
+  background: rgba(255, 255, 255, 0.12);
+  border: 1px solid rgba(255, 255, 255, 0.22);
+  backdrop-filter: blur(8px);
+  -webkit-backdrop-filter: blur(8px);
+}
+.avm-hx-portal__badge {
+  padding: 2px 8px;
+  border-radius: 999px;
+  font-size: 9px;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  background: rgba(255, 255, 255, 0.16);
+  border: 1px solid rgba(255, 255, 255, 0.35);
+}
+.avm-hx-portal__arrow {
+  margin-left: auto;
+  opacity: 0;
+  transform: translate(-6px, 6px);
+  transition:
+    opacity 0.3s ease,
+    transform 0.3s ease;
+}
+.avm-hx-portal:hover .avm-hx-portal__arrow,
+.avm-hx-portal:focus-visible .avm-hx-portal__arrow {
+  opacity: 1;
+  transform: none;
+}
+
+.avm-hx-portal__bottom {
+  position: absolute;
+  left: 16px;
+  right: 16px;
+  bottom: 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+#root .avm-hx-portal__name {
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: 1.25rem;
+  line-height: 1.1;
+  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
+}
+.avm-hx-portal__count {
+  font-size: 12px;
+  font-weight: 500;
+  color: rgba(255, 255, 255, 0.78);
+}
+
+/* AetherFy : dégradé de marque + ondes ; double largeur si la place le permet */
+.avm-hx-portal--aetherfy {
+  background: linear-gradient(120deg, #140b2e 0%, #3b1d7a 55%, #7c5cff 100%);
+}
+#root .avm-hx-portal--aetherfy .avm-hx-portal__name {
+  font-size: clamp(1.5rem, 2.6vw, 2.2rem);
+}
+.avm-hx-portal__waves {
+  position: absolute;
+  right: 22%;
+  top: 38%;
+  width: 18px;
+  height: 18px;
+}
+.avm-hx-portal__waves span {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  border: 1.5px solid rgba(255, 255, 255, 0.55);
+  opacity: 0;
+  animation: avm-hx-ping 3.6s ease-out infinite;
+}
+.avm-hx-portal__waves span:nth-child(2) { animation-delay: -1.2s; }
+.avm-hx-portal__waves span:nth-child(3) { animation-delay: -2.4s; }
+
+/* TV : dégradé d'origine de la tuile + balayage de signal */
+.avm-hx-portal--tv {
+  background: linear-gradient(120deg, #0a2540 0%, #1e5f74 50%, #2ec4b6 100%);
+}
+.avm-hx-portal--tv::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 4px);
+}
+
+@media (min-width: 1100px) {
+  .avm-hx-portal--aetherfy {
+    grid-column: span 2;
+    aspect-ratio: auto;
+  }
+}
+
+/* ---------- Rangées d'affiches ---------- */
+
+.avm-hx .avm-home-row {
+  margin-bottom: 2.2rem;
+}
+.avm-hx .avm-home-row h2 {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 1.2rem;
+  margin: 0 0 0.8rem;
+}
+.avm-hx .avm-home-row h2::before {
+  content: "";
+  width: 4px;
+  height: 1.1em;
+  border-radius: 2px;
+  background: linear-gradient(180deg, #7c5cff, #ec4899);
+}
+.avm-hx-count {
+  padding: 1px 9px;
+  border-radius: 999px;
+  font-size: 11px;
+  font-weight: 600;
+  color: var(--color-text-muted, #9a9aa3);
+  background: rgba(255, 255, 255, 0.07);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+}
+.avm-hx-live {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 2px 10px;
+  border-radius: 999px;
+  font-size: 10px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: #6ee7a0;
+  background: rgba(29, 185, 84, 0.12);
+  border: 1px solid rgba(29, 185, 84, 0.35);
+}
+.avm-hx-live::before {
+  content: "";
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: #1db954;
+  box-shadow: 0 0 0 0 rgba(29, 185, 84, 0.6);
+  animation: avm-hx-pulse 2s ease-out infinite;
+}
+.avm-hx .avm-home-row__scroll {
+  padding: 6px 4px 12px;
+}
+.avm-hx .avm-home-poster {
+  border-radius: 14px;
+  border-color: rgba(255, 255, 255, 0.08);
+  transition:
+    transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
+    border-color 0.3s ease,
+    box-shadow 0.3s ease;
+}
+.avm-hx .avm-home-poster:hover {
+  transform: translateY(-6px) scale(1.04);
+  border-color: rgba(124, 92, 255, 0.7);
+  box-shadow:
+    0 18px 34px rgba(0, 0, 0, 0.5),
+    0 0 0 1px rgba(124, 92, 255, 0.4),
+    0 0 36px rgba(124, 92, 255, 0.25);
+}
+
+/* ---------- Statistiques ---------- */
+
+.avm-hx-stats {
+  display: grid;
+  grid-template-columns: 1.15fr 1.1fr 0.95fr;
+  gap: 16px;
+}
+.avm-hx-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding: 20px;
+  border-radius: 20px;
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  color: #fff;
+  background:
+    linear-gradient(165deg, rgba(124, 92, 255, 0.16) 0%, rgba(14, 14, 20, 0.88) 60%),
+    #0e0e14;
+  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.3);
+  animation: avm-hx-rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+.avm-hx-card:nth-child(2) { animation-delay: 0.08s; }
+.avm-hx-card:nth-child(3) { animation-delay: 0.16s; }
+.avm-hx-card__label {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 12px;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: rgba(255, 255, 255, 0.7);
+}
+#root .avm-hx-big {
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: 1.9rem;
+  line-height: 1;
+}
+#root .avm-hx-big--xl {
+  font-size: clamp(2.6rem, 4.4vw, 3.6rem);
+  background: linear-gradient(90deg, #fff, #c4b5ff);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+.avm-hx-hint {
+  margin: 0;
+  line-height: 1.5;
+}
+
+/* Anneau de répartition */
+.avm-hx-donut {
+  position: relative;
+  width: 170px;
+  height: 170px;
+  margin: 0 auto;
+}
+.avm-hx-donut svg {
+  width: 100%;
+  height: 100%;
+}
+.avm-hx-donut__track,
+.avm-hx-donut__arc {
+  fill: none;
+  stroke-width: 12;
+}
+.avm-hx-donut__track {
+  stroke: rgba(255, 255, 255, 0.06);
+}
+.avm-hx-donut__arc {
+  transition: stroke-dasharray 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.avm-hx-donut__center {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+}
+.avm-hx-legend {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.avm-hx-legend li {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 13px;
+}
+.avm-hx-legend__dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  flex-shrink: 0;
+}
+.avm-hx-legend__name {
+  flex: 1;
+  color: rgba(255, 255, 255, 0.85);
+}
+.avm-hx-legend__count {
+  font-weight: 700;
+  color: #fff;
+}
+
+/* Time Capsule */
+.avm-hx-hours {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.avm-hx-chips {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 8px;
+}
+.avm-hx-chips > div {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 10px 12px;
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 0.06);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+}
+.avm-hx-chips strong {
+  font-size: 1.15rem;
+}
+.avm-hx-chips span {
+  font-size: 11px;
+  color: rgba(255, 255, 255, 0.6);
+}
+.avm-hx-week {
+  flex: 1;
+  min-height: 84px;
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: 8px;
+  align-items: end;
+}
+.avm-hx-week__day {
+  height: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.avm-hx-week__track {
+  flex: 1;
+  display: flex;
+  align-items: flex-end;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.05);
+  overflow: hidden;
+}
+.avm-hx-week__bar {
+  width: 100%;
+  border-radius: 8px;
+  background: linear-gradient(to top, #7c5cff, #c4b5ff);
+  transition: height 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.avm-hx-week__day--today .avm-hx-week__bar {
+  background: linear-gradient(to top, #ec4899, #ffb4d6);
+  box-shadow: 0 0 16px rgba(236, 72, 153, 0.5);
+}
+.avm-hx-week__letter {
+  text-align: center;
+  font-size: 11px;
+  color: rgba(255, 255, 255, 0.55);
+}
+.avm-hx-week__day--today .avm-hx-week__letter {
+  color: #fff;
+  font-weight: 700;
+}
+.avm-hx-link {
+  align-self: flex-start;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 14px;
+  border-radius: 999px;
+  font-size: 13px;
+  color: #fff;
+  cursor: pointer;
+  background: rgba(255, 255, 255, 0.1);
+  border: 1px solid rgba(255, 255, 255, 0.2);
+  transition:
+    background 0.3s ease,
+    color 0.3s ease,
+    gap 0.3s ease;
+}
+.avm-hx-link:hover,
+.avm-hx-link:focus-visible {
+  gap: 12px;
+  background: #fff;
+  color: #0e0e14;
+}
+
+/* Genres favoris */
+.avm-hx-genres {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+.avm-hx-genres__row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-bottom: 6px;
+  font-size: 13px;
+}
+.avm-hx-genres__rank {
+  width: 20px;
+  height: 20px;
+  display: grid;
+  place-items: center;
+  border-radius: 6px;
+  font-size: 11px;
+  font-weight: 700;
+  background: rgba(124, 92, 255, 0.25);
+}
+.avm-hx-genres__name {
+  flex: 1;
+  color: rgba(255, 255, 255, 0.9);
+}
+.avm-hx-genres__count {
+  font-weight: 700;
+}
+.avm-hx-genres__track {
+  display: block;
+  height: 6px;
+  border-radius: 6px;
+  background: rgba(255, 255, 255, 0.07);
+  overflow: hidden;
+}
+.avm-hx-genres__bar {
+  display: block;
+  height: 100%;
+  border-radius: 6px;
+  background: linear-gradient(90deg, #7c5cff, #ec4899);
+  transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+
+/* ---------- Animations ---------- */
+
+@keyframes avm-hx-rise {
+  from {
+    opacity: 0;
+    transform: translateY(14px);
+  }
+}
+@keyframes avm-hx-ping {
+  from {
+    transform: scale(1);
+    opacity: 0.7;
+  }
+  to {
+    transform: scale(9);
+    opacity: 0;
+  }
+}
+@keyframes avm-hx-pulse {
+  70% {
+    box-shadow: 0 0 0 8px rgba(29, 185, 84, 0);
+  }
+  100% {
+    box-shadow: 0 0 0 0 rgba(29, 185, 84, 0);
+  }
+}
+
+/* ---------- Fenêtre étroite ---------- */
+
+@media (max-width: 1100px) {
+  .avm-hx-stats {
+    grid-template-columns: 1fr 1fr;
+  }
+}
+@media (max-width: 760px) {
+  .avm-hx-stats {
+    grid-template-columns: 1fr;
+  }
+}
