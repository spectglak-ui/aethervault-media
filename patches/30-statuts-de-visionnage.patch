+/* Annotations « À voir / En cours / Vu » (0.7.9). */
+.avm-watchstate {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 1px 8px 1px 6px;
+  border-radius: 999px;
+  border: 1px solid currentColor;
+  font-size: 0.72rem;
+  font-weight: 600;
+  line-height: 1.5;
+  white-space: nowrap;
+}
+.avm-watchstate--todo {
+  color: var(--color-text-muted, #9aa0aa);
+  border-color: color-mix(in srgb, currentColor 45%, transparent);
+}
+.avm-watchstate--in_progress {
+  color: #f59e0b;
+  background: color-mix(in srgb, #f59e0b 12%, transparent);
+}
+.avm-watchstate--done {
+  color: #22c55e;
+  background: color-mix(in srgb, #22c55e 12%, transparent);
+}
+.avm-watchstate__count {
+  margin-left: 2px;
+  opacity: 0.85;
+  font-variant-numeric: tabular-nums;
+}
+
+/* Barre d'avancement d'un média « En cours ». */
+.avm-watchprogress {
+  height: 3px;
+  margin-top: 6px;
+  border-radius: 2px;
+  background: color-mix(in srgb, var(--color-text-muted, #9aa0aa) 30%, transparent);
+  overflow: hidden;
+}
+.avm-watchprogress__bar {
+  height: 100%;
+  background: #f59e0b;
+  border-radius: 2px;
+}
+
+/* Bouton « Marquer comme vu / non vu » d'une ligne d'épisode. */
+.avm-watchtoggle {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 30px;
+  height: 30px;
+  margin-right: 6px;
+  border: none;
+  border-radius: 50%;
+  background: transparent;
+  color: var(--color-text-muted, #9aa0aa);
+  cursor: pointer;
+  flex-shrink: 0;
+}
+.avm-watchtoggle:hover,
+.avm-watchtoggle:focus-visible {
+  color: var(--color-text, #fff);
+  background: color-mix(in srgb, var(--color-text-muted, #9aa0aa) 22%, transparent);
+}
+
+/* Ligne d'état + actions sur la page d'un titre. */
+.avm-watchpanel {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px;
+  margin-top: 0.75rem;
+}
+.avm-watchpanel__hint {
+  color: var(--color-text-muted, #9aa0aa);
+  font-size: 0.85rem;
+}
