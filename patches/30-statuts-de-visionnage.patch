+        add_series(&conn);
+        assert_eq!(status_of(&conn, 1), "todo");
+        let states = title_states(&conn, P, &[1, 10, 999]).unwrap();
+        assert!(states.iter().all(|s| s.status == "todo"));
+        assert_eq!(states[1].total, 3);
