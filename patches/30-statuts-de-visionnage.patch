+//! Statuts de visionnage « À voir / En cours / Vu » (0.7.9) — PAR PROFIL.
+//!
+//! La pose AUTOMATIQUE des statuts n'est pas ici : elle se fait à chaque
+//! sauvegarde de progression (`commands::playback::save_playback_progress` →
+//! `domain::playback::save_progress` → `domain::watch_state::record_progress`).
+//! Ces commandes servent à LIRE les statuts (grilles, listes d'épisodes, pages de
+//! titre) et au marquage MANUEL. Toutes agissent sur le profil actif.
+
+use serde::Serialize;
+
+use crate::db::repositories::watch_state_repository::{self as repo, MediaWatchRow};
+use crate::domain::watch_state::{self, ResumeTarget, TitleWatchState};
+use crate::state::AppState;
+
+/// Statut de plusieurs titres en une requête (grilles d'affiches). Tous les
+/// ids demandés sont renvoyés ; « À voir » par défaut.
+#[tauri::command]
+pub fn list_title_watch_states(
+    state: tauri::State<AppState>,
+    title_ids: Vec<i64>,
+) -> Result<Vec<TitleWatchState>, String> {
+    let profile_id = state.read_active_profile_id()?;
+    let conn = state.get_conn()?;
+    watch_state::title_states(&conn, profile_id, &title_ids)
+}
+
+/// Statut + avancement de plusieurs fichiers (listes d'épisodes, page d'un film).
+#[tauri::command]
+pub fn list_media_watch_states(
+    state: tauri::State<AppState>,
+    media_file_ids: Vec<i64>,
+) -> Result<Vec<MediaWatchRow>, String> {
+    let profile_id = state.read_active_profile_id()?;
+    let conn = state.get_conn()?;
+    repo::media_states(&conn, profile_id, &media_file_ids).map_err(|e| e.to_string())
+}
+
+/// Marquage manuel d'un fichier : `done` (« Vu ») ou `todo` (« À voir », efface
+/// aussi la position de reprise).
+#[tauri::command]
+pub fn set_media_watch_status(
+    state: tauri::State<AppState>,
+    media_file_id: i64,
+    status: String,
+) -> Result<(), String> {
+    let profile_id = state.read_active_profile_id()?;
+    let conn = state.get_conn()?;
+    watch_state::set_media_status(&conn, profile_id, media_file_id, &status)
+}
+
+/// Marquage manuel d'un titre entier (film, ou tous les épisodes d'une série).
+#[tauri::command]
+pub fn set_title_watch_status(
+    state: tauri::State<AppState>,
+    title_id: i64,
+    status: String,
+) -> Result<(), String> {
+    let profile_id = state.read_active_profile_id()?;
+    let conn = state.get_conn()?;
+    watch_state::set_title_status(&conn, profile_id, title_id, &status)
+}
+
+/// Épisode à proposer pour « Continuer » une série (`null` si tout est vu ou si
+/// la série n'a aucun épisode disponible).
+#[tauri::command]
+pub fn get_title_resume_target(
+    state: tauri::State<AppState>,
+    title_id: i64,
+) -> Result<Option<ResumeTarget>, String> {
+    let profile_id = state.read_active_profile_id()?;
+    let conn = state.get_conn()?;
+    watch_state::resume_target(&conn, profile_id, title_id)
+}
+
+/// Réglages de dosage exposés en lecture seule (diagnostic / page Paramètres).
+#[derive(Debug, Clone, Serialize)]
+pub struct WatchThresholds {
+    pub credits_tolerance_seconds: f64,
+    pub tail_ratio: f64,
+    pub tail_min_seconds: f64,
+    pub tail_max_seconds: f64,
+    pub in_progress_min_seconds: f64,
+}
+
+#[tauri::command]
+pub fn get_watch_thresholds() -> WatchThresholds {
+    WatchThresholds {
+        credits_tolerance_seconds: watch_state::CREDITS_TOLERANCE_SECONDS,
+        tail_ratio: watch_state::TAIL_RATIO,
+        tail_min_seconds: watch_state::TAIL_MIN_SECONDS,
+        tail_max_seconds: watch_state::TAIL_MAX_SECONDS,
+        in_progress_min_seconds: watch_state::IN_PROGRESS_MIN_SECONDS,
+    }
+}
diff --git a/apps/desktop/src-tauri/src/db/migrations/0028_media_watch_status.sql b/apps/desktop/src-tauri/src/db/migrations/0028_media_watch_status.sql
new file mode 100644
index 0000000..5b27f05
--- /dev/null
+++ b/apps/desktop/src-tauri/src/db/migrations/0028_media_watch_status.sql
@@ -0,0 +1,49 @@
+-- Migration 0028 — Statuts de visionnage automatiques « À voir / En cours / Vu »,
+-- PAR PROFIL et PAR FICHIER MÉDIA (un film = un fichier, un épisode = un fichier).
+--
+-- Principe : l'ABSENCE de ligne signifie « À voir » (état initial de tous les
+-- médias — aucune ligne à créer au scan). Une ligne n'existe que pour les états
+-- 'in_progress' (commencé, pas fini) et 'done' (vu).
+--
+-- Pourquoi une table dédiée plutôt que `playback_progress` : cette dernière est
+-- effacée dès qu'un média est terminé (voir `domain::playback`), ce qui
+-- faisait perdre l'information « déjà vu ». Elle reste la source de la
+-- position de reprise ; `media_watch_status` est la source du statut.
+--
+-- completed_by (diagnostic du dosage de « Vu », NULL tant que 'in_progress') :
+--   'ended'   fin du fichier atteinte
+--   'credits' arrêt à l'approche / pendant le générique de fin détecté (outro)
+--   'tail'    arrêt dans la queue de secours (générique inconnu)
+--   'manual'  marqué à la main par l'utilisateur
+
+CREATE TABLE media_watch_status (
+    profile_id    INTEGER NOT NULL REFERENCES profiles(id)    ON DELETE CASCADE,
+    media_file_id INTEGER NOT NULL REFERENCES media_files(id) ON DELETE CASCADE,
+    status        TEXT    NOT NULL CHECK (status IN ('in_progress', 'done')),
+    completed_by  TEXT    CHECK (completed_by IN ('ended', 'credits', 'tail', 'manual')),
+    updated_at    TEXT    NOT NULL,
+    PRIMARY KEY (profile_id, media_file_id)
+);
+CREATE INDEX idx_media_watch_status_media ON media_watch_status(media_file_id);
+CREATE INDEX idx_media_watch_status_profile_status ON media_watch_status(profile_id, status);
+
+-- Reprise de l'existant (une seule fois, à la mise à jour) --------------------
+-- 1) « Vu » : toute session d'historique qui s'était terminée à ≥ 95 % (ancien
+--    seuil) — c'est exactement ce qui effaçait la progression.
+INSERT OR IGNORE INTO media_watch_status (profile_id, media_file_id, status, completed_by, updated_at)
+SELECT wh.profile_id, wh.media_file_id, 'done', 'tail', MAX(wh.ended_at)
+FROM watch_history wh
+WHERE wh.duration_seconds > 0
+  AND wh.position_seconds / wh.duration_seconds >= 0.95
+  AND EXISTS (SELECT 1 FROM profiles p WHERE p.id = wh.profile_id)
+  AND EXISTS (SELECT 1 FROM media_files m WHERE m.id = wh.media_file_id)
+GROUP BY wh.profile_id, wh.media_file_id;
+
+-- 2) « En cours » : toute progression existante d'au moins 30 s et 1 % (les
+--    lignes déjà « Vu » ci-dessus l'emportent : INSERT OR IGNORE).
+INSERT OR IGNORE INTO media_watch_status (profile_id, media_file_id, status, completed_by, updated_at)
+SELECT pp.profile_id, pp.media_file_id, 'in_progress', NULL, pp.updated_at
+FROM playback_progress pp
+WHERE pp.duration_seconds > 0
+  AND pp.position_seconds >= 30
+  AND pp.position_seconds / pp.duration_seconds >= 0.01;
