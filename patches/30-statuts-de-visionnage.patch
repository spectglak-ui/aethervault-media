+        assert_eq!(status_of(&conn, 1), "done");
+        // Revoir 30 minutes ne le rend pas « En cours ».
+        record_progress(&conn, P, 1, 1800.0, FILM).unwrap();
+        assert_eq!(status_of(&conn, 1), "done");
+    }
+
+    #[test]
+    fn generique_detecte_d_un_episode_est_utilise() {
