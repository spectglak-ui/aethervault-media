+        assert_eq!(
+            rebase_path("/home/u/Photos/Vacances/sub/b.jpg", "/home/u/Photos/Vacances", "/home/u/Photos/Été 2024").as_deref(),
+            Some("/home/u/Photos/Été 2024/sub/b.jpg")
