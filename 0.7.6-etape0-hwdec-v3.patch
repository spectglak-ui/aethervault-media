-import { useState } from "react";
+import { useCallback, useEffect, useState } from "react";
+import { playerApi, type HwdecMode, type HwdecStatus } from "../features/player/api";
 import { getRenderQuality, setRenderQuality, type RenderQuality } from "../player/renderQuality";
 
+/**
+ * Nom du moteur WebGL réellement utilisé par la webview (ex. « ANGLE (Intel,
+ * … Direct3D11 …) »). Un nom contenant SwiftShader / Basic Render Driver /
+ * llvmpipe signale un WebGL logiciel : l'upload des images se fait alors sur
+ * le processeur et le gain d'un décodage matériel est annulé.
+ */
+function webglRendererLabel(): string {
+  try {
+    const canvas = document.createElement("canvas");
+    const gl = (canvas.getContext("webgl") ||
+      canvas.getContext("experimental-webgl")) as WebGLRenderingContext | null;
+    if (!gl) return "WebGL indisponible";
+    const info = gl.getExtension("WEBGL_debug_renderer_info");
+    const renderer = String(
+      info ? gl.getParameter(info.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER)
+    );
+    gl.getExtension("WEBGL_lose_context")?.loseContext();
+    return renderer;
+  } catch {
+    return "inconnu";
+  }
+}
+
+const SOFTWARE_WEBGL = /swiftshader|basic render|llvmpipe|software/i;
+
+/**
+ * Paramètres → Qualité de rendu → Décodage vidéo (0.7.6, étape 1 du plan GPU).
+ * « Logiciel » = comportement historique ; « Matériel avec recopie » demande à
+ * mpv `hwdec=auto-copy` (décodage sur la carte graphique, images recopiées en
+ * mémoire système). Le rendu reste logiciel dans les deux cas.
+ */
+function HwdecBlock() {
+  const [status, setStatus] = useState<HwdecStatus | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [webgl] = useState(() => webglRendererLabel());
+
+  const refresh = useCallback(() => {
+    playerApi
+      .getHwdecStatus()
+      .then((s) => {
+        setStatus(s);
+        setError(null);
+      })
+      .catch((e) => setError(String(e)));
+  }, []);
+  useEffect(() => {
+    refresh();
+  }, [refresh]);
+
+  const selected: HwdecMode = status?.mode === "auto" ? "auto" : "off";
+  const choose = async (mode: HwdecMode) => {
+    setBusy(true);
+    try {
+      setStatus(await playerApi.setHwdecMode(mode));
+      setError(null);
+    } catch (e) {
+      setError(String(e));
