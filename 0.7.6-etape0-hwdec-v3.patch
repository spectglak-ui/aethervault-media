+/// 0.7.6 : valeur `hwdec` forcée par la variable d'environnement développeur
+/// `AVM_HWDEC` (ex. `auto-copy`). Prioritaire sur le réglage des Paramètres.
+pub fn hwdec_env_override() -> Option<String> {
+    std::env::var("AVM_HWDEC")
+        .ok()
+        .map(|v| v.trim().to_string())
+        .filter(|v| !v.is_empty())
+}
+
+/// Modes de décodage vidéo proposés dans Paramètres → Qualité de rendu.
+pub const HWDEC_MODE_AUTO: &str = "auto";
+pub const HWDEC_MODE_OFF: &str = "off";
+
+/// Valeur `hwdec` de mpv correspondant à un mode de Paramètres.
+/// `auto-copy` est la seule forme compatible avec le rendu logiciel de
+/// l'application : le décodeur matériel recopie les images en mémoire
+/// système (les formes sans copie sont refusées par le backend SW de
+/// libmpv, qui retombe alors silencieusement sur le décodage CPU).
+pub fn hwdec_value_for_mode(mode: &str) -> Option<&'static str> {
+    match mode {
+        HWDEC_MODE_AUTO => Some("auto-copy"),
+        HWDEC_MODE_OFF => Some("no"),
+        _ => None,
+    }
+}
+
+/// État du décodage vu par mpv (voir `PlaybackEngineHandle::hwdec_live`).
+#[derive(Clone, Default, serde::Serialize)]
+pub struct HwdecLive {
+    /// Valeur de l'option `hwdec` actuellement demandée à mpv.
+    pub requested: String,
+    /// `hwdec-current` : méthode réellement active (`no` = logiciel).
+    /// Vide ou `no` tant qu'aucune vidéo n'est chargée.
+    pub current: String,
+}
+
+impl PlaybackEngineHandle {
+    /// 0.7.6 (étape 0) : journalise les versions de mpv et de FFmpeg
+    /// réellement chargées. Sans elles, impossible de savoir quels `hwdec`
+    /// ou quelles options existent dans la `libmpv-2.dll` embarquée.
+    fn log_runtime_versions(&self) {
+        let mpv_version = self
+            .get_property_string("mpv-version")
+            .unwrap_or_else(|e| format!("indisponible ({e})"));
+        let ffmpeg_version = self
+            .get_property_string("ffmpeg-version")
+            .unwrap_or_else(|e| format!("indisponible ({e})"));
+        log::info!("[playback] versions chargées : {mpv_version} · FFmpeg {ffmpeg_version}");
+    }
+
+    /// Applique un mode de décodage (`auto` | `off`) au moteur en marche.
+    /// Renvoie la valeur `hwdec` effectivement retenue : celle de
+    /// `AVM_HWDEC` si elle est définie (prioritaire, essais développeur),
+    /// sinon la valeur correspondant au mode. Un décodeur déjà actif peut
+    /// être réinitialisé par mpv au changement (courte interruption).
+    pub fn apply_hwdec_mode(&self, mode: &str) -> Result<String, String> {
+        if let Some(forced) = hwdec_env_override() {
+            log::info!(
+                "[playback] hwdec : AVM_HWDEC={forced} prioritaire sur le réglage « {mode} »"
+            );
+            return Ok(forced);
+        }
+        let value = hwdec_value_for_mode(mode)
+            .ok_or_else(|| format!("mode de décodage inconnu : {mode}"))?;
+        self.set_property_string("hwdec", value)?;
+        log::info!("[playback] hwdec appliqué : {value} (mode « {mode} »)");
+        Ok(value.to_string())
+    }
+
+    /// Valeur demandée et méthode réellement active, lues dans mpv.
+    pub fn hwdec_live(&self) -> HwdecLive {
+        HwdecLive {
+            requested: self.get_property_string_opt("hwdec").unwrap_or_default(),
+            current: self
+                .get_property_string_opt("hwdec-current")
+                .unwrap_or_default(),
+        }
+    }
+
+    fn set_property_string(&self, name: &str, value: &str) -> Result<(), String> {
+        let cname = CString::new(name).map_err(|e| e.to_string())?;
+        let cvalue = CString::new(value).map_err(|e| e.to_string())?;
+        // MPV_FORMAT_STRING : `data` pointe vers un `char *`.
+        let mut raw: *mut c_char = cvalue.as_ptr() as *mut c_char;
+        let rc = unsafe {
+            (self.functions.set_property)(
+                self.mpv.0,
+                cname.as_ptr(),
+                MpvFormat::String as c_int,
+                &mut raw as *mut _ as *mut c_void,
+            )
+        };
+        if rc < 0 {
+            Err(error_string(&self.functions, rc))
+        } else {
+            Ok(())
+        }
+    }
+}
