+// ---- Décodage vidéo matériel (0.7.6, étape 1 du plan GPU) --------------
+//
+// Réglage global à deux modes, enregistré dans la table `settings` (même
+// patron que la spatialisation audio) et poussé dans le moteur au
+// démarrage (voir `lib.rs`) :
+// - `off`  → `hwdec=no` (décodage logiciel) ;
+// - `auto` → `hwdec=auto-copy` (décodage matériel avec recopie en mémoire
+//   système, seule forme compatible avec le rendu logiciel).
+// Aucun réglage enregistré = comportement historique (`auto-safe`, qui
+// revient en pratique au décodage logiciel avec ce backend de rendu).
+
+const HWDEC_MODE_KEY: &str = "player_hwdec_mode";
+
+/// Mode enregistré (`auto` | `off`), ou `None` si aucun réglage valide.
+pub fn read_hwdec_mode(conn: &rusqlite::Connection) -> Option<String> {
+    crate::db::repositories::settings_repository::get(conn, HWDEC_MODE_KEY)
+        .ok()
+        .flatten()
+        .filter(|mode| crate::services::playback_engine::hwdec_value_for_mode(mode).is_some())
+}
+
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HwdecStatus {
+    /// `default` (aucun réglage enregistré), `auto` ou `off`.
+    pub mode: String,
+    /// Valeur `hwdec` actuellement demandée à mpv.
+    pub requested: String,
+    /// `hwdec-current` : méthode réellement active (`no` = logiciel).
+    pub current: String,
+    /// Valeur forcée par la variable d'environnement `AVM_HWDEC`, le cas échéant.
+    pub env_override: Option<String>,
+}
+
+fn build_hwdec_status(state: &AppState, mode: Option<String>) -> Result<HwdecStatus, String> {
+    let live = state.playback_engine.handle()?.hwdec_live();
+    Ok(HwdecStatus {
+        mode: mode.unwrap_or_else(|| "default".to_string()),
+        requested: live.requested,
+        current: live.current,
+        env_override: crate::services::playback_engine::hwdec_env_override(),
+    })
+}
+
+#[tauri::command]
+pub fn player_get_hwdec_status(state: tauri::State<AppState>) -> Result<HwdecStatus, String> {
+    let mode = {
+        let conn = state.get_conn()?;
+        read_hwdec_mode(&conn)
+    };
+    build_hwdec_status(&state, mode)
+}
+
+/// Applique le mode au moteur PUIS l'enregistre : un mode refusé par la
+/// version de libmpv installée n'est jamais persisté.
+#[tauri::command]
+pub fn player_set_hwdec_mode(
+    state: tauri::State<AppState>,
+    mode: String,
+) -> Result<HwdecStatus, String> {
+    if crate::services::playback_engine::hwdec_value_for_mode(&mode).is_none() {
+        return Err(format!("Mode de décodage inconnu : {mode}"));
+    }
+    state.playback_engine.handle()?.apply_hwdec_mode(&mode)?;
+    {
+        let conn = state.get_conn()?;
+        crate::db::repositories::settings_repository::set(&conn, HWDEC_MODE_KEY, &mode)
+            .map_err(|e| e.to_string())?;
+    }
+    build_hwdec_status(&state, Some(mode))
+}
+
