diff --git a/apps/desktop/src-tauri/src/services/playback_engine/bench.rs b/apps/desktop/src-tauri/src/services/playback_engine/bench.rs
new file mode 100644
index 0000000..dc9cab7
--- /dev/null
+++ b/apps/desktop/src-tauri/src/services/playback_engine/bench.rs
@@ -0,0 +1,56 @@
+//! Mesures du pipeline de rendu logiciel (mode benchmark, 0.7.6).
+//!
+//! Isolé dans son propre module pour que `sw_render.rs` ne porte que les
+//! points de mesure eux-mêmes (voir `AVM_BENCH`).
+
+use std::time::Instant;
+
+/// 0.7.6 (étape 0 du plan GPU) : mode benchmark. Quand `AVM_BENCH` est défini
+/// (et ≠ `0`), la boucle de rendu mesure la durée de chaque étape et en
+/// publie un résumé toutes les 2 s (ligne `[AV-DIAG] étapes 2 s`). Hors de ce
+/// mode, aucune mesure n'est faite : comportement et coût inchangés.
+pub(super) fn bench_enabled() -> bool {
+    std::env::var("AVM_BENCH")
+        .map(|v| !v.is_empty() && v != "0")
+        .unwrap_or(false)
+}
+
+/// Échantillons de durée (ms) d'une étape sur la fenêtre de 2 s courante.
+#[derive(Default)]
+pub(super) struct StageTimer {
+    samples_ms: Vec<f32>,
+}
+
+impl StageTimer {
+    pub(super) fn record(&mut self, started: Instant) {
+        self.samples_ms.push(started.elapsed().as_secs_f32() * 1000.0);
+    }
+
+    /// `p50/p95/max` en ms, puis remise à zéro de la fenêtre.
+    pub(super) fn summary(&mut self) -> String {
+        if self.samples_ms.is_empty() {
+            return "-".to_string();
+        }
+        self.samples_ms.sort_by(|a, b| a.total_cmp(b));
+        let n = self.samples_ms.len();
+        let p50 = self.samples_ms[n / 2];
+        let p95 = self.samples_ms[((n * 95) / 100).min(n - 1)];
+        let max = self.samples_ms[n - 1];
+        self.samples_ms.clear();
+        format!("{p50:.2}/{p95:.2}/{max:.2}")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::StageTimer;
+
+    #[test]
+    fn stage_timer_summary_reports_percentiles_and_resets() {
+        let mut timer = StageTimer::default();
+        assert_eq!(timer.summary(), "-");
+        timer.samples_ms.extend((1..=100).map(|v| v as f32));
+        assert_eq!(timer.summary(), "51.00/96.00/100.00");
+        assert!(timer.samples_ms.is_empty());
+    }
+}
