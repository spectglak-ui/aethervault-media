{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherVault Media",
  "version": "0.1.0",
  "identifier": "com.aethervault.media",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
	"withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AetherVault Media",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--ignore-gpu-blocklist"
      },
      {
        "label": "player",
        "title": "AetherVault Media — Lecteur",
        "url": "index.html",
        "width": 420,
        "height": 280,
        "minWidth": 280,
        "minHeight": 180,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "additionalBrowserArgs": "--ignore-gpu-blocklist"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}