{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherVault Media",
  "version": "0.2.1",
  "identifier": "com.aethervault.media",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
	"withGlobalTauri": true,
    "windows": [
          {
      "label": "main",
      "title": "AetherVault Media",
      "width": 1100,
      "height": 720,
      "minWidth": 900,
      "minHeight": 600,
      "resizable": true,
      "center": true,
      "maximized": true,
      "decorations": false,
      "additionalBrowserArgs": "--ignore-gpu-blocklist"
    },
      {
        "label": "player",
        "title": "AetherVault Media — Lecteur",
        "url": "index.html",
        "width": 420,
        "height": 280,
        "minWidth": 280,
        "minHeight": 180,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "additionalBrowserArgs": "--ignore-gpu-blocklist"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
      "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "libs/libmpv-2.dll": "libmpv-2.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}