# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build Outputs (Tauri & Rust) ---
# On ignore le dossier target complet (contient les binaires compilés)
apps/desktop/src-tauri/target/
target/

# On garde Cargo.lock à la racine et dans src-tauri pour la stabilité des versions
# Mais on ignore les locks temporaires
**/*.rs.bk

# --- Frontend Build ---
dist/
build/
apps/desktop/dist/

# --- Environment Variables ---
.env
.env.local
.env.*.local

# --- IDE & OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing ---
coverage/
.nyc_output/

# --- Specific to your project structure if needed ---
# Si vous téléchargez libmpv localement pour le dev, ignorez-le ici
# et téléchargez-le via CI. Sinon, retirez cette ligne.
apps/desktop/src-tauri/libs/*.dll
apps/desktop/src-tauri/libs/*.dylib
apps/desktop/src-tauri/libs/*.so